{attribute 'pack_mode' := '1'}
TYPE ST_Ventilation_Unit_Config :
STRUCT
    unit_id : BYTE := 0;
    unit_type : E_VENTILATION_UNIT_TYPE;
    location : E_VENTILATION_LOCATION;
    min_speed : BYTE := 20;
    max_speed : BYTE := 100;
    Threshold_Hum : REAL := 65.0;
    has_smoke_detector : BOOL := FALSE;
END_STRUCT
END_TYPE
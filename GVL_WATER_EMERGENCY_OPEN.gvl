{attribute 'qualified_only'}
VAR_GLOBAL
    // HMI/runtime surface for emergency temporary opening of normally-open
    // water shutoff valves during active leak alarm.
    // Valve group 1 -> physical valve chain 35.
    // Valve group 2 -> physical valve chain 36.
    G_Request_Open : BOOL := FALSE;
    G_Request_Close_Now : BOOL := FALSE;
    G_Target_Valve_Group : INT := 0;
    G_Duration_Minutes : INT := 1; // allowed values: 1, 3, 5

    G_Open_Valve_35_Active : BOOL := FALSE;
    G_Open_Valve_36_Active : BOOL := FALSE;
    G_Open_Active : ARRAY[1..2] OF BOOL;
    G_Open_Start_MS : ARRAY[1..2] OF UDINT;
    G_Open_Duration_MS : ARRAY[1..2] OF UDINT;
    G_Open_Count_Today : ARRAY[1..2] OF INT;

    G_Daily_Reset_MS : UDINT := 0;
    G_Last_Request_Accepted : BOOL := FALSE;
    G_Last_Request_Denied : BOOL := FALSE;
    G_Last_Denial_Code : UINT := 0;
    G_Status_Text : STRING(200) := '';
    G_Last_Update_MS : UDINT := 0;
END_VAR
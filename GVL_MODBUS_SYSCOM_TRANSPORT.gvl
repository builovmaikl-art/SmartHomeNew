{attribute 'qualified_only'}
VAR_GLOBAL
    // ======================================================
    // MODBUS RTU SYSCOM BYTE TRANSPORT BOUNDARY
    // ======================================================
    // This GVL is the byte-pipe boundary for a concrete SysCom
    // implementation.
    //
    // Project side:
    //   - publishes TX buffer from GVL_MODBUS_RTU_FRAME.G_TX_Frame
    //   - imports RX buffer into GVL_MODBUS_RTU_FRAME.G_RX_Frame
    //
    // Concrete SysCom side must:
    //   - send G_TX_Buffer when G_TX_Request = TRUE
    //   - set G_TX_Done or G_TX_Error after physical write
    //   - fill G_RX_Buffer/G_RX_Length and set G_RX_Ready only after
    //     a complete RTU frame has been assembled
    //
    // No fake RX or fake Done is generated by project logic.

    G_Transport_Enabled : BOOL := FALSE;
    G_Transport_Attached : BOOL := FALSE;

    G_TX_Request : BOOL := FALSE;
    G_TX_Buffer : ARRAY[0..255] OF BYTE;
    G_TX_Length : UINT := 0;
    G_TX_Done : BOOL := FALSE;
    G_TX_Error : BOOL := FALSE;
    G_TX_Error_Code : WORD := 0;

    G_RX_Ready : BOOL := FALSE;
    G_RX_Buffer : ARRAY[0..255] OF BYTE;
    G_RX_Length : UINT := 0;
    G_RX_Error : BOOL := FALSE;
    G_RX_Error_Code : WORD := 0;

    // RX assembler state inside SysCom backend
    G_RX_Assembler_Active : BOOL := FALSE;
    G_RX_Assembler_Length : UINT := 0;
    G_RX_Assembler_Last_Byte_MS : UDINT := 0;
    G_RX_Assembler_InterFrame_MS : UDINT := 20;
    G_RX_Assembler_Overflow : BOOL := FALSE;

    G_Last_TX_Request_MS : UDINT := 0;
    G_Last_TX_Done_MS : UDINT := 0;
    G_Last_RX_MS : UDINT := 0;

    G_Total_TX : UDINT := 0;
    G_Total_RX : UDINT := 0;
    G_Total_Errors : UDINT := 0;
    G_Total_RX_Overflow : UDINT := 0;
    G_Total_RX_Short_Frame : UDINT := 0;
END_VAR

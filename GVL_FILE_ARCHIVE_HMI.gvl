{attribute 'qualified_only'}
VAR_GLOBAL
    // HMI intent surface for file/archive operations.
    // This is a request/configuration surface only. The actual runtime status is
    // published by GVL_FILE_ARCHIVE and mirrored to GVL_HMI by PRG_HMI_Dashboard.

    // Archive configuration request.
    G_Set_Archive_Config_Req : BOOL := FALSE;
    G_Archive_Interface_Enabled : BOOL := FALSE;
    G_CSV_Write_Enabled : BOOL := FALSE;
    G_File_Archive_Target_Code : BYTE := 0; // 0=none, 1=PLC file/flash, 2=USB, 3=gateway

    // Automatic configuration backup schedule request.
    // Time is milliseconds from start of effective day; default 03:00.
    G_Set_Auto_Config_Backup_Req : BOOL := FALSE;
    G_Auto_Config_Backup_Enabled : BOOL := FALSE;
    G_Auto_Config_Backup_Time_Of_Day_MS : UDINT := 10800000;

    // One-shot archive write requests.
    G_Write_Event_CSV_Req : BOOL := FALSE;
    G_Write_Trend_CSV_Req : BOOL := FALSE;
    G_Write_BlackBox_CSV_Req : BOOL := FALSE;
    G_Write_Config_Backup_Req : BOOL := FALSE;

    // Applicator feedback.
    G_Last_Status_Text : STRING(200) := '';
    G_Last_Error : BOOL := FALSE;
    G_Last_Error_Code : UDINT := 0;
    G_Last_Update_MS : UDINT := 0;
END_VAR

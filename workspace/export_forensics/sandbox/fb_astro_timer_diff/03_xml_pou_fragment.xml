<pou name="FB_Astro_Timer" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="VI_System_Time_MS">
              <type>
                <UDINT />
              </type>
            </variable>
            <variable name="VI_Latitude">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="55.75" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Москва</xhtml>
              </documentation>
            </variable>
            <variable name="VI_Longitude">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="37.61" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="VO_Sunset_Time">
              <type>
                <TOD />
              </type>
            </variable>
            <variable name="VO_Sunrise_Time">
              <type>
                <TOD />
              </type>
            </variable>
            <variable name="VO_Is_Night">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="L_Current_TOD">
              <type>
                <TOD />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Упрощенная логика астро-таймера (ТЗ 15.2)
// В реальном проекте используется библиотека SysTimeRtc или расчет по формулам
L_Current_TOD := UDINT_TO_TOD(VI_System_Time_MS MOD 86400000);

// Примерные значения для средней полосы
VO_Sunrise_Time := TOD#06:00;
VO_Sunset_Time := TOD#18:00;

// ТЗ 15.2: Закат + 30 мин / Рассвет - 30 мин
VO_Is_Night := (L_Current_TOD &gt; (VO_Sunset_Time + T#30m)) OR (L_Current_TOD &lt; (VO_Sunrise_Time - T#30m));
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/buildproperties" handleUnknown="implementation">
            <BuildProperties>
              <LinkAlways>true</LinkAlways>
            </BuildProperties>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>c11e3ad9-dfa3-45a3-b482-6189f4d7c53f</ObjectId>
          </data>
        </addData>
      </pou>
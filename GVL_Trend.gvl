VAR_GLOBAL
    // === TREND HMI DATA ===
    G_Trend_Avg : REAL;
    G_Trend_Min : REAL;
    G_Trend_Max : REAL;
    G_Trend_Up : BOOL;
    G_Trend_Down : BOOL;

    // === TREND BUFFER FOR HMI ===
    G_Trend_Buffer : ARRAY[1..50] OF REAL;
    G_Trend_Buffer_Index : INT;

    G_Trend_Buffer_Timestamps : ARRAY[1..50] OF UDINT;


    // === TREND META FOR HMI ===
    G_Trend_Valid_Count : INT;
    G_Trend_Is_Wrapped : BOOL;
    G_Trend_Last_Update_MS : UDINT;
    G_Trend_Param_Type : BYTE;


    // === MULTI-SIGNAL TREND FOUNDATION ===
    G_Trend_Selected_Channel : BYTE := 1;
    G_Trend_Channel2_Enabled : BOOL := FALSE;
    G_Trend_Buffer_2 : ARRAY[1..50] OF REAL;
    G_Trend_Buffer_2_Timestamps : ARRAY[1..50] OF UDINT;
    G_Trend_Buffer_2_Index : INT;
    G_Trend_Buffer_2_Valid_Count : INT;
    G_Trend_Buffer_2_Is_Wrapped : BOOL;
    G_Trend_Channel2_Param_Type : BYTE := 0;


    // === HMI-FACING TREND NORMALIZATION ===
    G_Trend_Active_Param_Type : BYTE;
    G_Trend_Active_Label : STRING(32);
    G_Trend_Channel1_Label : STRING(32) := 'Outdoor Temp';
    G_Trend_Channel2_Label : STRING(32) := 'Floor Temp';

END_VAR

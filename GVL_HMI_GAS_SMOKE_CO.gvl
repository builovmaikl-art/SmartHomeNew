{attribute 'qualified_only'}
VAR_GLOBAL
    G_Methane_Effective : ARRAY[1..GVL_CONSTANTS.C_MAX_METHANE_SENSORS] OF REAL;
    G_Methane_Max_LEL : REAL;
    G_Methane_Warning_Level : BOOL;
    G_Methane_Alarm_Level : BOOL;
    G_Methane_Critical_Level : BOOL;

    G_CO_Effective : ARRAY[1..GVL_CONSTANTS.C_MAX_CO_SENSORS] OF REAL;
    G_CO_Max_PPM : REAL;
    G_CO_Warning_Level : BOOL;
    G_CO_Alarm_Level : BOOL;

    G_Smoke_Effective : ARRAY[1..GVL_CONSTANTS.C_MAX_SMOKE_SENSORS] OF BOOL;
    G_Smoke_Active_Count : UINT;
    G_Smoke_Detected : BOOL;

    G_Gas_Detected : BOOL;
    G_Status_Text : STRING(200);
    G_Status_Level : INT := 0; // 0=OK, 1=WARN, 2=ALARM, 3=CRITICAL

    G_Safety_Fire_Alarm_Active : BOOL;
    G_Safety_Gas_Alarm_Active : BOOL;
    G_Safety_CO_Warning_Active : BOOL;
    G_Gas_Close_Required : BOOL;
    G_Boiler_Stop_Required : BOOL;
    G_System_Safe_Stop_Required : BOOL;
    G_Evacuation_Mode_Active : BOOL;
    G_Vent_Stop_Required : BOOL;
    G_Vent_Force_PV3_Boost : BOOL;
    G_Vent_Force_Supply_100 : BOOL;
    G_Vent_Force_Supply_80 : BOOL;
    G_Vent_Force_Exhaust_100 : BOOL;

    G_Vent_Output_Enable : BOOL;
    G_Vent_Output_Supply_Fans : ARRAY[1..GVL_CONSTANTS.C_MAX_SUPPLY_FANS] OF UINT;
    G_Vent_Output_Exhaust_Fans : ARRAY[1..GVL_CONSTANTS.C_MAX_EXHAUST_FANS] OF UINT;
END_VAR

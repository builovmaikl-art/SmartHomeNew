{attribute 'qualified_only'}
VAR_GLOBAL
    // Runtime discovery state is rebuilt by FB_Runtime_Node_Discovery
    // during cyclic execution. It must not consume RETAIN memory.
    G_Discovery_State : ARRAY[1..32] OF ST_Runtime_Node_Discovery_State;

    G_Runtime_Valid : BOOL;
    G_Last_Update_MS : UDINT;

    G_Any_Node_Quarantined : BOOL;
    G_Any_Discovery_Rejected : BOOL;

    G_Status_Code : UINT;
    G_Status_Text : STRING(160);
END_VAR
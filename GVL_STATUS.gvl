{attribute 'qualified_only'}
VAR_GLOBAL
    G_System_Time_MS : UDINT; // Системное время в миллисекундах
    G_Last_System_Time_MS : UDINT := 0; // Предыдущее системное время (для детекции переполнения)
    G_Time_Of_Day_MS : UDINT := 0; // Время от начала суток в мс (0-86399999)
    G_Current_Day : UINT := 1; // Текущий день недели (1-7)
    G_Day_Of_Year : UINT := 1; // Текущий день года (1-365)
    G_Current_TOD : TOD; // Текущее время суток
    G_Current_Scenario : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE; // Текущий активный сценарий
    G_Previous_Scenario : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE; // Предыдущий сценарий
    G_Is_Night : BOOL; // Флаг ночного времени
    G_PLC_ID : BYTE := 1; // 1 = PLC_A, 2 = PLC_B
    G_Is_Active_PLC : BOOL;
    G_Local_PLC_ID : BYTE := 1; // Идентификатор данного ПЛК в паре
    G_Active_PLC_ID : BYTE := 1; // Идентификатор ведущего ПЛК
    G_Remote_PLC_Pulse : BOOL; // Сигнал "жизни" от второго ПЛК
    G_Security_Status_Msg : STRING(200);
    G_Gas_Status_Msg : STRING(200);
    G_Flood_Status_Msg : STRING(200);
    G_Vent_Status_Msg : STRING(200);
    G_DHW_Status : ST_DHW_Status;
    G_Manifold_Status : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF ST_Manifold_Status;
    G_Boiler_Status : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF ST_Boiler_Status;
    G_IO_Modules_Online : ARRAY[1..GVL_CONSTANTS.C_MAX_MODULES] OF BOOL; // Статусы модулей ввода-вывода
    G_Sim_Active : BOOL;
    G_Wet_Zone_Light_Active : BOOL;
    G_System_Mode_Msg : STRING(200); // Пояснение текущего режима работы системы для HMI
    G_System_Mode_Cause : STRING(200); // Корневая причина режима (пожар/газ/протечка/штатно)
    G_Evac_Target_Zone_Name : STRING(80); // Предпочтительная зона выхода/направления эвакуации
    G_Evac_Hazard_Zone_Name : STRING(80); // Наиболее важная опасная зона для HMI/диагностики
    G_Diagnostics : ST_System_Diagnostics; // Интегральная диагностика и HMI-состояния

    // === D1 Structured Diagnostics ===
    G_Diagnostics_Events : ARRAY[1..50] OF ST_Diagnostic_Event;
    G_Diagnostics_Count : INT := 0;
END_VAR

<pou name="FB_History_Manager" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_Write_Event">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VI_Event">
        <type>
          <derived name="ST_History_Record" />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Total_Events">
        <type>
          <UDINT />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="L_Prev_Write_Event">
        <type>
          <BOOL />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">IF VI_Write_Event AND NOT L_Prev_Write_Event THEN
    GVL_Retain.G_History_Buffer[GVL_Retain.G_History_Write_Idx] := VI_Event;
    GVL_Retain.G_History_Buffer[GVL_Retain.G_History_Write_Idx].timestamp_ms := VI_System_Time_MS;
    
    GVL_Retain.G_History_Write_Idx := (GVL_Retain.G_History_Write_Idx MOD GVL_CONSTANTS.C_MAX_HISTORY_RECORDS) + 1;
    GVL_Retain.G_History_Total_Events := GVL_Retain.G_History_Total_Events + 1;
END_IF;
L_Prev_Write_Event := VI_Write_Event;

VO_Total_Events := GVL_Retain.G_History_Total_Events;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_History_Manager &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>

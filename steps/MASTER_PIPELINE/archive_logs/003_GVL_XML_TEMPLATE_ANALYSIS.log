      </variable>
    </outputVars>
    <inOutVars>
      <variable name="VI_Manual_Override">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL" />
        </type>
      </variable>
      <variable name="VI_Physical_Switches">

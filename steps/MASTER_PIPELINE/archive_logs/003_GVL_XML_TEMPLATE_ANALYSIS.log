<pou name="FB_Simulation_Manager" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_IsActivePLC">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VI_Scenario">
        <type>
          <derived name="E_SCENARIO_TYPE" />
        </type>
      </variable>
      <variable name="VI_Config">
        <type>
          <derived name="ST_Scenario_Config" />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Sim_Lights">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHTING_ZONES] OF BOOL" />
        </type>
      </variable>
      <variable name="VO_Sim_Active">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Sim_Water_Leak">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_FLOOD_SENSORS] OF BOOL" />
        </type>
      </variable>
      <variable name="VO_Sim_Gas_Leak">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_METHANE_SENSORS] OF REAL" />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="L_Random">
        <type>
          <derived name="FB_Random_Generator" />
        </type>
      </variable>
      <variable name="L_Last_Toggle">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="L_i">
        <type>
          <INT />
        </type>
      </variable>
      <variable name="L_Rand_Val">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="L_Test_Mode">
        <type>
          <derived name="BOOL := FALSE" />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">IF VI_Scenario = E_SCENARIO_TYPE.SCENARIO_AWAY AND VI_Config.Presence_Simulation_Enabled THEN
    VO_Sim_Active := TRUE;
    
    // Переключаем свет каждые 30 минут
    IF F_TimeDiff(VI_System_Time_MS, L_Last_Toggle) &gt;= (GVL_CONSTANTS.C_MS_IN_MINUTE * 30) THEN
        L_Last_Toggle := VI_System_Time_MS;
        
        FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_LIGHTING_ZONES DO
            L_Rand_Val := L_Random.Random_Int_Range(VI_min := 0, VI_max := 100);
            VO_Sim_Lights[L_i] := (L_Rand_Val &gt; 80); // 20% шанс включения
        END_FOR;
    END_IF;
ELSE
    VO_Sim_Active := FALSE;
    FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_LIGHTING_ZONES DO VO_Sim_Lights[L_i] := FALSE; END_FOR;
END_IF;

// Симуляция аварий в тестовом режиме
IF L_Test_Mode THEN
    // Генерация случайных протечек (очень редко)
    L_Rand_Val := L_Random.Random_Int_Range(VI_min := 0, VI_max := 100000);
    IF L_Rand_Val = 42 THEN
        VO_Sim_Water_Leak[1] := TRUE;
    END_IF;
    
    // Симуляция утечки газа
    L_Rand_Val := L_Random.Random_Int_Range(VI_min := 0, VI_max := 100000);
    IF L_Rand_Val = 77 THEN
        VO_Sim_Gas_Leak[1] := 15.0; // 15% LEL
    END_IF;
ELSE
    FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_FLOOD_SENSORS DO VO_Sim_Water_Leak[L_i] := FALSE; END_FOR;
    FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_METHANE_SENSORS DO VO_Sim_Gas_Leak[L_i] := 0.0; END_FOR;
END_IF;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_Simulation_Manager &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>
--- CONTAINER END ---


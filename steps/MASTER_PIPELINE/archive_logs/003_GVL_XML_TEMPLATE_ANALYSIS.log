<pou name="FB_AccessCode_Manager" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_IsActivePLC">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VI_Code_To_Check">
        <type>
          <derived name="STRING(4)" />
        </type>
      </variable>
      <variable name="VI_RFID_To_Check">
        <type>
          <derived name="STRING(20)" />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Code_Valid">
        <type>
          <BOOL />
        </type>
      </variable>
    </outputVars>
    <inOutVars>
      <variable name="VI_Access_Codes">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_ACCESS_CODES] OF DWORD" />
        </type>
      </variable>
      <variable name="VI_RFID_Tags">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_ACCESS_CODES] OF STRING(20)" />
        </type>
      </variable>
    </inOutVars>
    <localVars>
      <variable name="L_i">
        <type>
          <INT />
        </type>
      </variable>
      <variable name="pCode">
        <type>
          <derived name="POINTER TO BYTE" />
        </type>
      </variable>
      <variable name="L_CRC_Calc">
        <type>
          <derived name="FB_CRC32_Calculator" />
        </type>
      </variable>
      <variable name="L_Input_Hash">
        <type>
          <DWORD />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">VO_Code_Valid := FALSE;

// Вычисляем хэш введенного кода
IF LEN(VI_Code_To_Check) &gt; 0 THEN
    pCode := ADR(VI_Code_To_Check);
    L_Input_Hash := L_CRC_Calc.Calculate(VI_DataRef := pCode^, VI_Size := TO_UDINT(LEN(VI_Code_To_Check)));
    FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_ACCESS_CODES DO
        IF VI_Access_Codes[L_i] &lt;&gt; 0 AND VI_Access_Codes[L_i] = L_Input_Hash THEN
            VO_Code_Valid := TRUE;
            RETURN;
        END_IF;
    END_FOR;
END_IF;

// Проверяем RFID метку
IF LEN(VI_RFID_To_Check) &gt; 0 THEN
    FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_ACCESS_CODES DO
        IF VI_RFID_Tags[L_i] &lt;&gt; '' AND VI_RFID_Tags[L_i] = VI_RFID_To_Check THEN
            VO_Code_Valid := TRUE;
            RETURN;
        END_IF;
    END_FOR;
END_IF;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_AccessCode_Manager &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>

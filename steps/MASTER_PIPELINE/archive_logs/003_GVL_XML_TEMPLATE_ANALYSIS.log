          <BOOL />
        </type>
      </variable>
      <variable name="VO_Circ_Pump">
        <type>
          <BOOL />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="fbDHWV2Staging">
        <type>
          <derived name="FB_DHW_V2_Staging_DRAFT" />
        </type>
      </variable>
      <variable name="L_DHW_V2_Command_Shadow">
        <type>
          <derived name="ST_DHW_Command_V2" />
        </type>
      </variable>
      <variable name="L_DHW_V2_State_Shadow">
        <type>
          <derived name="ST_DHW_State_V2" />
        </type>
      </variable>
      <variable name="L_DHW_V2_Shadow_Diff_Found">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_DHW_V2_Switch_Enabled">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_DHW_V2_Path_Ready">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_DHW_Using_Legacy_Fallback">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_i">
        <type>
          <INT />
        </type>
      </variable>
      <variable name="L_Current_TOD">
        <type>
          <TOD />
        </type>
      </variable>
      <variable name="L_Legionella_Active">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Legionella_Timer">
        <type>
          <derived name="FB_System_Timer" />
        </type>
      </variable>
      <variable name="L_Last_Good_Temp">
        <type>
          <derived name="REAL := 55.0" />
        </type>
      </variable>
      <variable name="L_Legionella_Done_Today">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Last_Legionella_Day">
        <type>
          <UINT />
        </type>
      </variable>
      <variable name="fbTempValidator">
        <type>
          <derived name="FB_Analog_Validator" />
        </type>
      </variable>
      <variable name="fbPressValidator">
        <type>
          <derived name="FB_Analog_Validator" />
        </type>
      </variable>
      <variable name="L_Error_Latched">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Error_ID_Latched">
        <type>
          <DWORD />
        </type>
      </variable>
      <variable name="L_Policy_Degraded">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Policy_Freeze_Protection">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Policy_Safe_Stop">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Target_Temp_Adjusted">
        <type>
          <REAL />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">// &gt;&gt;&gt; SYNC_TEST_MARKER_001 &lt;&lt;&lt;


IF NOT VI_IsActivePLC THEN RETURN; END_IF;

L_DHW_V2_Shadow_Diff_Found := FALSE;
L_DHW_V2_Switch_Enabled := TRUE;
L_DHW_V2_Path_Ready := FALSE;
L_DHW_Using_Legacy_Fallback := TRUE;

GVL_STATE.G_DHW_IO_Fault := FALSE;
GVL_STATE.G_DHW_Sensor_Fault := FALSE;
GVL_STATE.G_DHW_Subsystem_Degraded := FALSE;

IF VI_Emergency_Stop THEN
    VO_Heating_Pump := FALSE;
    VO_Circ_Pump := FALSE;
    VO_Status.Warning := FALSE;
    VO_Status.Error := TRUE;
    VO_Status.Error_ID := GVL_CONFIG.ERR_DHW_IO_OFFLINE; // временно используем общий аварийный код до детализации safety-кодов
    VO_Status.Heating_Pump_On := FALSE;
    VO_Status.Circ_Pump_On := FALSE;
    RETURN;
END_IF;

// Фиксация текущего времени
L_Current_TOD := VI_Current_TOD;

// ========================================
// DHW POLICY LAYER
// ========================================

<pou name="FB_BlackBox_Recorder" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_Current_Data">
        <type>
          <derived name="ST_BlackBox_Record" />
        </type>
      </variable>
      <variable name="VI_Freeze">
        <type>
          <BOOL />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Frozen">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Records_Count">
        <type>
          <INT />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="L_Write_Index">
        <type>
          <derived name="INT := 0" />
        </type>
      </variable>
      <variable name="L_Initialized">
        <type>
          <derived name="BOOL := FALSE" />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">IF NOT L_Initialized THEN
    L_Write_Index := GVL_Retain.G_BlackBox_LastIndex;
    IF L_Write_Index &lt; 0 OR L_Write_Index &gt;= GVL_CONSTANTS.C_MAX_BLACKBOX_RECORDS THEN
        L_Write_Index := 0;
        GVL_Retain.G_BlackBox_LastIndex := 0;
    END_IF;
    L_Initialized := TRUE;
END_IF;

IF VI_Freeze THEN
    GVL_Retain.G_BlackBox_Frozen := TRUE;
END_IF;

VO_Frozen := GVL_Retain.G_BlackBox_Frozen;

IF NOT GVL_Retain.G_BlackBox_Frozen THEN
    GVL_Retain.G_BlackBox_Buffer[L_Write_Index] := VI_Current_Data;
    GVL_Retain.G_BlackBox_LastIndex := L_Write_Index;
    
    L_Write_Index := L_Write_Index + 1;
    IF L_Write_Index &gt;= GVL_CONSTANTS.C_MAX_BLACKBOX_RECORDS THEN
        L_Write_Index := 0;
    END_IF;
END_IF;

VO_Records_Count := GVL_CONSTANTS.C_MAX_BLACKBOX_RECORDS; // Размер кольцевого буфера
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_BlackBox_Recorder &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>
--- CONTAINER END ---


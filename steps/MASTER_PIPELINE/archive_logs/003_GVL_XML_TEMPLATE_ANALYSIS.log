<pou name="FB_NVRAM_Manager" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_Command">
        <type>
          <BYTE />
        </type>
      </variable>
      <variable name="VI_Offset">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_DataRef">
        <type>
          <derived name="REFERENCE TO BYTE" />
        </type>
      </variable>
      <variable name="VI_DataSize">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_Operator_ID">
        <type>
          <derived name="STRING(10)" />
        </type>
      </variable>
      <variable name="VI_IsActivePLC">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VI_TwoPersonConfirmation">
        <type>
          <BOOL />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Done">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Error">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_ErrorID">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VO_ReadDataRef">
        <type>
          <derived name="REFERENCE TO BYTE" />
        </type>
      </variable>
      <variable name="VO_HMI_Status_Message">
        <type>
          <derived name="STRING(200)" />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="L_prev_Command">
        <type>
          <BYTE />
        </type>
      </variable>
      <variable name="L_cmd_rising">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_i">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="L_Last_Write_Time_MS">
        <type>
          <derived name="UDINT := 0" />
        </type>
      </variable>
      <variable name="L_Data_Changed">
        <type>
          <BOOL />
        </type>
      </variable>
    </localVars>
    <localVars>
      <variable name="C_MAX_NVRAM_SIZE">
        <type>
          <derived name="UDINT := 12800" />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">// Детекция фронта команды
L_cmd_rising := (VI_Command &lt;&gt; 0) AND (L_prev_Command = 0);
L_prev_Command := VI_Command;

IF L_cmd_rising THEN
    VO_Done := FALSE;
    VO_Error := FALSE;
    VO_ErrorID := 0;
    VO_HMI_Status_Message := '';
    
    // Валидация смещения
    IF VI_Offset &gt;= C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#1501;
        VO_HMI_Status_Message := 'NVRAM: Неверное смещение';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    // Валидация указателя
    IF NOT __ISVALIDREF(VI_DataRef) THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150A;
        VO_HMI_Status_Message := 'NVRAM: Недействительная ссылка на данные';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    IF (VI_Offset + VI_DataSize) &gt; C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150B;
        VO_HMI_Status_Message := 'NVRAM: Размер данных превышает доступный объем';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    IF VI_Command = 1 THEN // ЗАПИСЬ (WRITE)
        IF NOT VI_IsActivePLC THEN
            VO_Error := TRUE;
            VO_ErrorID := 16#1509;
            VO_HMI_Status_Message := 'NVRAM: Запись запрещена (STANDBY)';
        ELSE
            // Ограничение частоты записи (не чаще 1 раза в 60 секунд)
            IF F_TimeDiff(VI_System_Time_MS, L_Last_Write_Time_MS) &lt; 60000 AND L_Last_Write_Time_MS &lt;&gt; 0 THEN
                VO_Error := TRUE;
                VO_ErrorID := 16#150C;
                VO_HMI_Status_Message := 'NVRAM: Превышена частота записи (лимит 1 раз в 60с)';
            ELSE
                // Проверка на изменение данных перед записью
                L_Data_Changed := FALSE;
                IF MEMCMP(ADR(GVL_Retain.G_NVRAM_Data[VI_Offset]), ADR(VI_DataRef), VI_DataSize) &lt;&gt; 0 THEN
                    L_Data_Changed := TRUE;
                END_IF;
                
                IF L_Data_Changed THEN
                    // Копируем данные используя MEMCPY
                    MEMCPY(ADR(GVL_Retain.G_NVRAM_Data[VI_Offset]), ADR(VI_DataRef), VI_DataSize);
                    L_Last_Write_Time_MS := VI_System_Time_MS;
                    VO_HMI_Status_Message := 'NVRAM: Данные успешно сохранены в RETAIN';
                ELSE
                    VO_HMI_Status_Message := 'NVRAM: Данные не изменились, запись пропущена';
                END_IF;
            END_IF;
        END_IF;
        VO_Done := TRUE;
        
    ELSIF VI_Command = 2 THEN // ЧТЕНИЕ (READ)
        // Копируем данные используя MEMCPY
        MEMCPY(ADR(VI_DataRef), ADR(GVL_Retain.G_NVRAM_Data[VI_Offset]), VI_DataSize);
        VO_ReadDataRef REF= VI_DataRef;
        VO_HMI_Status_Message := 'NVRAM: Данные успешно прочитаны из RETAIN';
        VO_Done := TRUE;
    END_IF;
END_IF;

IF VI_Command = 0 THEN
    VO_Done := FALSE;
END_IF;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_NVRAM_Manager &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>
--- CONTAINER END ---


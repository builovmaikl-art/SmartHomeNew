<pou name="FB_Astro_Timer" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_Latitude">
        <type>
          <derived name="REAL := 55.75" />
        </type>
      </variable>
      <variable name="VI_Longitude">
        <type>
          <derived name="REAL := 37.61" />
        </type>
      </variable>
      <variable name="VI_Timezone">
        <type>
          <derived name="REAL := 3.0" />
        </type>
      </variable>
      <variable name="VI_Day_Of_Year">
        <type>
          <UINT />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Sunset_Time">
        <type>
          <TOD />
        </type>
      </variable>
      <variable name="VO_Sunrise_Time">
        <type>
          <TOD />
        </type>
      </variable>
      <variable name="VO_Is_Night">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Current_TOD">
        <type>
          <TOD />
        </type>
      </variable>
    </outputVars>
    <localVars>
      <variable name="L_Current_TOD">
        <type>
          <TOD />
        </type>
      </variable>
      <variable name="L_Pi">
        <type>
          <derived name="REAL := 3.14159265359" />
        </type>
      </variable>
      <variable name="L_Rad">
        <type>
          <derived name="REAL := 3.14159265359 / 180.0" />
        </type>
      </variable>
      <variable name="L_Deg">
        <type>
          <derived name="REAL := 180.0 / 3.14159265359" />
        </type>
      </variable>
      <variable name="L_B">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_EoT">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_Declination">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_Cos_Omega">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_Omega">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_Sunrise_Local">
        <type>
          <REAL />
        </type>
      </variable>
      <variable name="L_Sunset_Local">
        <type>
          <REAL />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">// &gt;&gt;&gt; SYNC_TEST_MARKER_002 &lt;&lt;&lt;


L_Current_TOD := GVL_STATUS.G_Current_TOD;
VO_Current_TOD := L_Current_TOD;

// Equation of Time (EoT) in minutes
L_B := 360.0 / 365.0 * TO_REAL(VI_Day_Of_Year - 81) * L_Rad;
L_EoT := 9.87 * SIN(2.0 * L_B) - 7.53 * COS(L_B) - 1.5 * SIN(L_B);

// Solar Declination in degrees
L_Declination := 23.45 * SIN(360.0 / 365.0 * TO_REAL(VI_Day_Of_Year + 284) * L_Rad);

// Hour angle
L_Cos_Omega := -TAN(VI_Latitude * L_Rad) * TAN(L_Declination * L_Rad);

IF L_Cos_Omega &gt; 1.0 THEN
    L_Cos_Omega := 1.0; // Polar night
ELSIF L_Cos_Omega &lt; -1.0 THEN
    L_Cos_Omega := -1.0; // Polar day
END_IF;

L_Omega := ACOS(L_Cos_Omega) * L_Deg;

// Sunrise and Sunset in local time (hours)
L_Sunrise_Local := 12.0 - (L_Omega / 15.0) - (L_EoT / 60.0) + (VI_Timezone * 15.0 - VI_Longitude) / 15.0;
L_Sunset_Local := 12.0 + (L_Omega / 15.0) - (L_EoT / 60.0) + (VI_Timezone * 15.0 - VI_Longitude) / 15.0;

// Handle bounds
IF L_Sunrise_Local &lt; 0.0 THEN L_Sunrise_Local := L_Sunrise_Local + 24.0; END_IF;
IF L_Sunrise_Local &gt;= 24.0 THEN L_Sunrise_Local := L_Sunrise_Local - 24.0; END_IF;
IF L_Sunset_Local &lt; 0.0 THEN L_Sunset_Local := L_Sunset_Local + 24.0; END_IF;
IF L_Sunset_Local &gt;= 24.0 THEN L_Sunset_Local := L_Sunset_Local - 24.0; END_IF;

// Конвертация в TOD
VO_Sunrise_Time := TO_TOD(TO_UDINT(L_Sunrise_Local * 3600000.0));
VO_Sunset_Time := TO_TOD(TO_UDINT(L_Sunset_Local * 3600000.0));

// ТЗ 15.2: Закат + 30 мин / Рассвет - 30 мин
VO_Is_Night := (L_Current_TOD &gt; (VO_Sunset_Time + T#30m)) OR (L_Current_TOD &lt; (VO_Sunrise_Time - T#30m));
// &gt;&gt;&gt; SYNC_TEST_MARKER_FORCE &lt;&lt;&lt;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_Astro_Timer &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>
--- CONTAINER END ---


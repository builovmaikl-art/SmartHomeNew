<pou name="FB_Water_Leakage_Manager" pouType="functionBlock">
  <interface>
    <inputVars>
      <variable name="VI_System_Time_MS">
        <type>
          <UDINT />
        </type>
      </variable>
      <variable name="VI_IsActivePLC">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VI_Config">
        <type>
          <derived name="ST_Flood_Global_Config" />
        </type>
      </variable>
    </inputVars>
    <outputVars>
      <variable name="VO_Close_Valve_35">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Close_Valve_36">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Status_Msg">
        <type>
          <derived name="STRING(200)" />
        </type>
      </variable>
      <variable name="VO_Leak_Detected">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="VO_Leak_Warning_Level">
        <type>
          <BOOL />
        </type>
      </variable>
    </outputVars>
    <inOutVars>
      <variable name="VI_Sensors">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_FLOOD_SENSORS] OF BOOL" />
        </type>
      </variable>
    </inOutVars>
    <localVars>
      <variable name="L_i">
        <type>
          <INT />
        </type>
      </variable>
      <variable name="L_Sensor_Timers">
        <type>
          <derived name="ARRAY[1..GVL_CONSTANTS.C_MAX_FLOOD_SENSORS] OF FB_System_Timer" />
        </type>
      </variable>
      <variable name="L_Any_Leak">
        <type>
          <BOOL />
        </type>
      </variable>
      <variable name="L_Any_Warning">
        <type>
          <BOOL />
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml xmlns="http://www.w3.org/1999/xhtml">IF NOT VI_IsActivePLC THEN RETURN; END_IF;

L_Any_Leak := FALSE;
L_Any_Warning := FALSE;

FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_FLOOD_SENSORS DO
    L_Sensor_Timers[L_i](
        IN := VI_Sensors[L_i],
        PT := TO_TIME(VI_Config.min_duration_ms + VI_Config.warning_duration_ms),
        VI_System_Time_MS := VI_System_Time_MS
    );

    IF L_Sensor_Timers[L_i].ET &gt;= TO_TIME(VI_Config.min_duration_ms) THEN
        L_Any_Warning := TRUE;

        IF L_Sensor_Timers[L_i].Q THEN
            L_Any_Leak := TRUE;

            IF VI_Config.sensor_to_valve_map[L_i] = 1 THEN
                VO_Close_Valve_35 := TRUE;
            ELSIF VI_Config.sensor_to_valve_map[L_i] = 2 THEN
                VO_Close_Valve_36 := TRUE;
            END_IF;
        END_IF;
    END_IF;
END_FOR;

// Health signals
VO_Leak_Detected := L_Any_Leak;
VO_Leak_Warning_Level := L_Any_Warning;

// Status
IF L_Any_Leak THEN
    VO_Status_Msg := 'АВАРИЯ: ПРОТЕЧКА ВОДЫ. КЛАПАНЫ ЗАКРЫТЫ.';
ELSIF L_Any_Warning THEN
    VO_Status_Msg := 'ПРЕДУПРЕЖДЕНИЕ: ОБНАРУЖЕНА ВОДА.';
ELSE
    VO_Status_Msg := 'Система контроля протечек в норме';
    VO_Close_Valve_35 := FALSE;
    VO_Close_Valve_36 := FALSE;
END_IF;
// &gt;&gt;&gt; BULK_SYNC_ANCHOR: FB_Water_Leakage_Manager &lt;&lt;&lt;</xhtml>
    </ST>
  </body>
</pou>
--- CONTAINER END ---


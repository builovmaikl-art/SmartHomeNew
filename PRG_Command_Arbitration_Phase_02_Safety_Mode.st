PROGRAM PRG_Command_Arbitration_Phase_02_Safety_Mode
// Command arbitration phase 02: project safety mode into deterministic buffer.

GVL_COMMAND_ARBITRATION_BUFFER.B_Mode := GVL_SAFETY_SHUTDOWN.G_Safety_Mode;
GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := FALSE;

CASE GVL_COMMAND_ARBITRATION_BUFFER.B_Mode OF

    NORMAL:
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := FALSE;

    FIRE:
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := GVL_COMMAND_POLICY_CONFIG.G_Fire_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := GVL_COMMAND_POLICY_CONFIG.G_Fire_Stop_Boiler;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := FALSE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_PV3_Boost := FALSE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Exhaust_100_Req := FALSE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Smoke_Exhaust := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := GVL_COMMAND_POLICY_CONFIG.G_Fire_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_1_Open := GVL_COMMAND_POLICY_CONFIG.G_Fire_Open_Lock_1;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_2_Open := GVL_COMMAND_POLICY_CONFIG.G_Fire_Open_Lock_2;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Gate_Open := GVL_COMMAND_POLICY_CONFIG.G_Fire_Open_Gate;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Wicket_Open := GVL_COMMAND_POLICY_CONFIG.G_Fire_Open_Wicket;

    GAS:
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Gas_Valve_Close := GVL_COMMAND_POLICY_CONFIG.G_Gas_Close_Gas;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := GVL_COMMAND_POLICY_CONFIG.G_Gas_Stop_Boiler;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := GVL_COMMAND_POLICY_CONFIG.G_Gas_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Gas_Safety_Stop := GVL_COMMAND_POLICY_CONFIG.G_Gas_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_PV3_Boost := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Supply_100_Req := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Smoke_Exhaust := FALSE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Gate_Open := GVL_COMMAND_POLICY_CONFIG.G_Gas_Open_Gate;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Wicket_Open := GVL_COMMAND_POLICY_CONFIG.G_Gas_Open_Wicket;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_1_Open := GVL_COMMAND_POLICY_CONFIG.G_Gas_Open_Lock_1;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_2_Open := GVL_COMMAND_POLICY_CONFIG.G_Gas_Open_Lock_2;

    WATER_LEAK:
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := GVL_COMMAND_POLICY_CONFIG.G_Water_Block_Water;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := GVL_COMMAND_POLICY_CONFIG.G_Water_Block_Water;
        // WATER_LEAK means a water safety event is active, but 35/36 are the
        // zone-4/common-inlet pair. Do not close them for single local leaks in
        // zones 1..3 unless main-close/fallback/test-timeout requires it.
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 :=
            GVL_INTENT_SAFETY.I_Water_Main_Close_Required
            OR GVL_INTENT_SAFETY.I_Test_Timeout_Water_Close;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 :=
            GVL_INTENT_SAFETY.I_Water_Main_Close_Required
            OR GVL_INTENT_SAFETY.I_Test_Timeout_Water_Close;

    GLOBAL_STOP:
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Heating;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Stop_Boiler;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Stop_Vent;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Water;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Water;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Water;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 := GVL_COMMAND_POLICY_CONFIG.G_GlobalStop_Block_Water;

ELSE
        GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Gas_Valve_Close := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 := TRUE;
        GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 := TRUE;
END_CASE;

IF GVL_INTENT_SAFETY.I_Vent_Force_Supply_100 THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Supply_100_Req := TRUE;
END_IF;

IF GVL_INTENT_SAFETY.I_Vent_Force_Supply_80 THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Supply_80_Req := TRUE;
END_IF;

IF GVL_INTENT_SAFETY.I_Vent_Force_PV3_Boost THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_PV3_Boost := TRUE;
END_IF;

IF GVL_INTENT_SAFETY.I_Vent_Force_Exhaust_100 THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Exhaust_100_Req := TRUE;
END_IF;

IF GVL_INTENT_SAFETY.I_Vent_Stop_Required THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := TRUE;
END_IF;

// >>> BULK_SYNC_ANCHOR: PRG_Command_Arbitration_Phase_02_Safety_Mode <<<
END_PROGRAM
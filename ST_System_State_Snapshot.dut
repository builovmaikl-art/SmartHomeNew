{attribute 'pack_mode' := '1'}
TYPE ST_System_State_Snapshot :
STRUCT
    // ======================================================
    // LEGACY DIRECT STATE REPLICATION SNAPSHOT
    // ======================================================
    // Used by legacy redundancy helpers that replicate/apply
    // domain state directly.
    //
    // This DUT is NOT the current distributed runtime protocol.
    // Current runtime-safe HA topology uses:
    // - GVL_PEER_SESSION
    // - GVL_HA_SESSION_REPLICATION
    // - PRG_Distributed_Peer_Ingestion
    // - PRG_Distributed_Commit_Ingestion
    //
    // Do not connect this snapshot path to MAIN as a parallel
    // HA runtime path without explicit barrier/governance review.
    // ======================================================

    System_Time_MS : UDINT;
    Current_Scenario : E_SCENARIO_TYPE;
    Security_Armed : BOOL;
    Active_Alarms : INT;
    // Критические состояния для синхронизации
    Zone_Valves : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF BOOL;
    Manifold_Pumps : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    Lighting_States : ARRAY[1..32] OF BYTE;
    Blinds_Positions : ARRAY[1..GVL_CONSTANTS.C_MAX_BLINDS] OF BYTE;
    Socket_States : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;
    Gas_Valve_Closed : BOOL;
    Water_Valves_Closed : BOOL;
    Version : UDINT; // Версия состояния для разрешения конфликтов
END_STRUCT
END_TYPE
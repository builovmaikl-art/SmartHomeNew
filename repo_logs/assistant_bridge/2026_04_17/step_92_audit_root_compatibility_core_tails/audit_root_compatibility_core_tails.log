END_FUNCTION_BLOCK

FUNCTION_BLOCK FB_BlackBox_V2_Core
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_System_Mode : INT;
    VI_Critical_Alarm_Active : BOOL;
    VI_Warning_Active : BOOL;
    VI_First_Fault_Type : BYTE;

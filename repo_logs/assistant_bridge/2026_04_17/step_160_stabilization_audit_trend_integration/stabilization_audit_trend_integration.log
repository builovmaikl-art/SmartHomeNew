--- FILE: FB_Trend_Logger.st ---
exists=True
line_count=33
preview:
FUNCTION_BLOCK FB_Trend_Logger
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_Config : ST_Trend_Config;
    VI_Current_Value : REAL;
END_VAR
VAR_OUTPUT
    VO_Data : ST_Trend_Data;
END_VAR
VAR
    L_Last_Log_Time : UDINT;
    L_Last_Value : REAL;
    L_Deviation : REAL;
END_VAR

IF NOT VI_Config.enabled THEN RETURN; END_IF;

// Логирование по изменению (Deadband) или по времени (раз в час)
L_Deviation := ABS(VI_Current_Value - L_Last_Value);
IF (L_Deviation >= (L_Last_Value * VI_Config.deviation_threshold_percent / 100.0)) OR 
   ((SEL(VI_System_Time_MS >= L_Last_Log_Time, VI_System_Time_MS - L_Last_Log_Time, (4294967295 - L_Last_Log_Time) + VI_System_Time_MS + 1)) >= GVL_CONSTANTS.C_MS_IN_HOUR) THEN
    
    // Запись в массив
    VO_Data.write_index := (VO_Data.record_count MOD 100) + 1;
    VO_Data.values[VO_Data.write_index] := VI_Current_Value;
    VO_Data.timestamps[VO_Data.write_index] := VI_System_Time_MS;

    VO_Data.record_count := VO_Data.record_count + 1;
    VO_Data.sum_values := VO_Data.sum_values + VI_Current_Value;
    
    L_Last_Value := VI_Current_Value;
    L_Last_Log_Time := VI_System_Time_MS;
END_IF;

--- FILE: FB_Trend_Analyzer.st ---
exists=True
line_count=37
preview:
FUNCTION_BLOCK FB_Trend_Analyzer
VAR_INPUT
    VI_Count      : INT;
END_VAR
VAR_IN_OUT
    VI_Data       : ARRAY[1..GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS] OF REAL;
END_VAR
VAR_OUTPUT
    VO_Average    : REAL;
    VO_Max        : REAL;
    VO_Min        : REAL;
    VO_Trend_Up   : BOOL;
    VO_Trend_Down : BOOL;
END_VAR
VAR
    L_i   : INT;
    L_Sum : REAL;
END_VAR

IF VI_Count > 0 AND VI_Count <= GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS THEN
    VO_Max := VI_Data[1];
    VO_Min := VI_Data[1];
    L_Sum := 0.0;
    
    FOR L_i := 1 TO VI_Count DO
        IF VI_Data[L_i] > VO_Max THEN VO_Max := VI_Data[L_i]; END_IF;
        IF VI_Data[L_i] < VO_Min THEN VO_Min := VI_Data[L_i]; END_IF;
        L_Sum := L_Sum + VI_Data[L_i];
    END_FOR;
    
    VO_Average := L_Sum / INT_TO_REAL(VI_Count);
    
    IF VI_Count >= 2 THEN
        VO_Trend_Up := (VI_Data[VI_Count] > VI_Data[1]);
        VO_Trend_Down := (VI_Data[VI_Count] < VI_Data[1]);
    END_IF;
END_IF;

--- FILE: FB_Trend_Adapter.st ---
exists=True
line_count=49
preview:
FUNCTION_BLOCK FB_Trend_Adapter
VAR_INPUT
    VI_Data : ST_Trend_Data;
END_VAR

VAR_OUTPUT
    VO_Average : REAL;
    VO_Min : REAL;
    VO_Max : REAL;
    VO_Trend_Up : BOOL;
    VO_Trend_Down : BOOL;
END_VAR

VAR
    fbAnalyzer : FB_Trend_Analyzer;
    L_Data_Copy : ARRAY[1..GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS] OF REAL;
    L_Count : INT;
    L_i : INT;
END_VAR

// Normalize count to analyzer bounds
L_Count := UDINT_TO_INT(VI_Data.record_count);
IF L_Count < 0 THEN
    L_Count := 0;
END_IF;
IF L_Count > GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS THEN
    L_Count := GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS;
END_IF;

// Copy source values into analyzer-compatible buffer
FOR L_i := 1 TO GVL_CONSTANTS.C_MAX_TREND_DATA_POINTS DO
    L_Data_Copy[L_i] := 0.0;
END_FOR;

IF L_Count > 0 THEN
    FOR L_i := 1 TO L_Count DO
        L_Data_Copy[L_i] := VI_Data.values[L_i];
    END_FOR;
END_IF;


363:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Validation_OK := TRUE;
364:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Validation_Text := CONCAT('Газ не обнаружен, зона: ', GVL_STATUS.G_Diagnostics.Active_Gas_Zone_Name);
366:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Validation_OK := FALSE;
367:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Validation_Text := CONCAT('Подтверждение запрещено: активен газ в зоне ', GVL_STATUS.G_Diagnostics.Active_Gas_Zone_Name);
368:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Forced_Close := TRUE;
369:            GVL_COMMAND.G_Gas_Valve_Close := TRUE;
370:            L_Gas_Test_Active := FALSE;
371:            GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Mode_Active := FALSE;
374:        L_Gas_Test_Active := FALSE;
375:        GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Mode_Active := FALSE;
376:        GVL_COMMAND.G_Gas_Valve_Close := TRUE;
379:IF L_CMD_Gas_Valve_Test_Close_Edge THEN
380:    L_Gas_Test_Active := FALSE;
381:    GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Mode_Active := FALSE;
382:    GVL_COMMAND.G_Gas_Valve_Close := TRUE;
384:IF L_CMD_Gas_Valve_Test_Confirm_Edge AND L_Gas_Test_Active THEN
385:    IF GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Validation_OK THEN
386:        L_Gas_Test_Active := FALSE;
387:        GVL_STATUS.G_Diagnostics.Gas_Valve_Test_Mode_Active := FALSE;

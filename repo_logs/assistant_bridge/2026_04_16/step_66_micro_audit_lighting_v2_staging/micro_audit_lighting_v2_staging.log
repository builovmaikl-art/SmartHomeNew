    VI_Alarm_Active := GVL_STATE.G_Lighting_IO_Fault OR GVL_STATE.G_Lighting_Subsystem_Degraded,

    VO_Command_Shadow => L_Lighting_V2_Command_Shadow,
    VO_State_Shadow => L_Lighting_V2_State_Shadow

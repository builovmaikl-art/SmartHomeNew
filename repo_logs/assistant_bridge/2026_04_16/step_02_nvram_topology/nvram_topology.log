{attribute 'pack_mode' := '1'}
TYPE ST_State_Snapshot :
STRUCT
    timestamp_ms : UDINT := 0;
    operator_id : STRING(10) := '';
    scenario_id : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    lighting_levels : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHTING_ZONES] OF BYTE;
    floor_heating_setpoints : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF REAL;
    alarm_active : BOOL := FALSE;
    crc32 : DWORD := 0;
END_STRUCT
END_TYPE

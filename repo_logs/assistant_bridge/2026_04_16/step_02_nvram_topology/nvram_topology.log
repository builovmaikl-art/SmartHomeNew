FILE: GVL_Retain.gvl
----------------------------------------------------------------------
{attribute 'qualified_only'}
VAR_GLOBAL RETAIN
    G_Initialized : BOOL := FALSE; // Флаг инициализации retain-переменных
    
    // Энергонезависимая память (NVRAM) для хранения настроек и логов
    G_NVRAM_Data : ARRAY[0..12799] OF BYTE; // 100 * 128 = 12800 байт
    
    // Буфер черного ящика (100 записей)
    G_BlackBox_Buffer : ARRAY[0..GVL_CONSTANTS.C_MAX_BLACKBOX_RECORDS-1] OF ST_BlackBox_Record;
    G_BlackBox_LastIndex : INT;
    G_BlackBox_Frozen : BOOL;
    G_Presence_History : ARRAY[0..GVL_CONSTANTS.C_MAX_PRESENCE_HISTORY-1] OF WORD; // 168 часов * 6 записей в час = 1008 записей (битовая маска 16 ламп)
    
    // История событий
    G_History_Buffer : ARRAY[1..GVL_CONSTANTS.C_MAX_HISTORY_RECORDS] OF ST_History_Record;
    G_History_Write_Idx : INT := 1;
    G_History_Total_Events : UDINT;
    
    // Статистика котлов
    G_Boiler_Accumulated_MS : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF UDINT;
    G_Boiler_Work_Seconds : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF UDINT;
    
    // Результаты тестирования клапанов
    G_Valve_Test_Results : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    
    // ПИН-коды доступа (храним хэши CRC32 для безопасности)
    // 16#9BE3E0A3 - это CRC32 от строки '1234'
    G_Access_Codes : ARRAY[1..GVL_CONSTANTS.C_MAX_ACCESS_CODES] OF DWORD := [16#9BE3E0A3, 16#4A89A12D, 16#F4DBDF21, 16#90F59C65, 16#0972D346, 0, 0, 0, 0, 0];
    
    // Зарегистрированные RFID/NFC метки (строковое представление UID)
    G_RFID_Tags : ARRAY[1..GVL_CONSTANTS.C_MAX_ACCESS_CODES] OF STRING(20) := ['A1B2C3D4', 'E5F67890', '', '', '', '', '', '', '', ''];
END_VAR
----------------------------------------------------------------------
FILE: FB_NVRAM_Manager.st
----------------------------------------------------------------------
FUNCTION_BLOCK FB_NVRAM_Manager
VAR_INPUT
    VI_Command                  : BYTE; // 1=WRITE, 2=READ
    VI_Offset                   : UDINT; // Смещение в байтах
    VI_DataRef                  : REFERENCE TO BYTE;
    VI_DataSize                 : UDINT; // КРИТИЧНО: используем этот размер вместо SIZEOF
    VI_System_Time_MS           : UDINT;
    VI_Operator_ID              : STRING(10);
    VI_IsActivePLC              : BOOL;
    VI_TwoPersonConfirmation    : BOOL;
END_VAR
VAR_OUTPUT
    VO_Done                     : BOOL;
    VO_Error                    : BOOL;
    VO_ErrorID                  : UDINT;
    // VO_ReadDataRef removed (REFERENCE TO not allowed in output)
    VO_HMI_Status_Message       : STRING(200);
END_VAR
VAR
    L_prev_Command              : BYTE;
    L_cmd_rising                : BOOL;
    L_i                         : UDINT;
    L_Last_Write_Time_MS        : UDINT := 0; // Время последней записи
    L_Data_Changed              : BOOL; // Флаг изменения данных
    L_pData                      : POINTER TO BYTE;
END_VAR
VAR CONSTANT
    C_MAX_NVRAM_SIZE            : UDINT := 12800;
END_VAR

// Детекция фронта команды
L_cmd_rising := (VI_Command <> 0) AND (L_prev_Command = 0);
L_prev_Command := VI_Command;

IF L_cmd_rising THEN
    VO_Done := FALSE;
    VO_Error := FALSE;
    VO_ErrorID := 0;
    VO_HMI_Status_Message := '';
    
    // Валидация смещения
    IF VI_Offset >= C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#1501;
        VO_HMI_Status_Message := 'NVRAM: Неверное смещение';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    // Валидация указателя
    IF NOT __ISVALIDREF(VI_DataRef) THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150A;
        VO_HMI_Status_Message := 'NVRAM: Недействительная ссылка на данные';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    L_pData := ADR(VI_DataRef);

    IF (VI_Offset + VI_DataSize) > C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150B;
        VO_HMI_Status_Message := 'NVRAM: Размер данных превышает доступный объем';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    IF VI_Command = 1 THEN // ЗАПИСЬ (WRITE)
        IF NOT VI_IsActivePLC THEN
            VO_Error := TRUE;
            VO_ErrorID := 16#1509;
            VO_HMI_Status_Message := 'NVRAM: Запись запрещена (STANDBY)';
        ELSE
            // Ограничение частоты записи (не чаще 1 раза в 60 секунд)
            IF (VI_System_Time_MS - L_Last_Write_Time_MS) < 60000 AND L_Last_Write_Time_MS <> 0 THEN
                VO_Error := TRUE;
                VO_ErrorID := 16#150C;
                VO_HMI_Status_Message := 'NVRAM: Превышена частота записи (лимит 1 раз в 60с)';
            ELSE
                // Проверка на изменение данных перед записью
                L_Data_Changed := FALSE;
                IF TRUE THEN
                    L_Data_Changed := TRUE;
                END_IF;
                
                IF L_Data_Changed THEN
                    // Безопасное копирование (WRITE)
                    FOR L_i := 0 TO VI_DataSize - 1 DO
                        GVL_Retain.G_NVRAM_Data[VI_Offset + L_i] := L_pData[L_i];
                    END_FOR;
                    L_Last_Write_Time_MS := VI_System_Time_MS;
                    VO_HMI_Status_Message := 'NVRAM: Данные успешно сохранены в RETAIN';
                ELSE
                    VO_HMI_Status_Message := 'NVRAM: Данные не изменились, запись пропущена';
                END_IF;
            END_IF;
        END_IF;
        VO_Done := TRUE;
        
    ELSIF VI_Command = 2 THEN // ЧТЕНИЕ (READ)
        // Безопасное копирование (READ)
        FOR L_i := 0 TO VI_DataSize - 1 DO
            L_pData[L_i] := GVL_Retain.G_NVRAM_Data[VI_Offset + L_i];
        END_FOR;
        VO_HMI_Status_Message := 'NVRAM: Данные успешно прочитаны из RETAIN';
        VO_Done := TRUE;
    END_IF;
END_IF;

IF VI_Command = 0 THEN
    VO_Done := FALSE;
END_IF;
// >>> BULK_SYNC_ANCHOR: FB_NVRAM_Manager <<<

----------------------------------------------------------------------
FILE: FB_State_Snapshot_Manager.st
----------------------------------------------------------------------
FUNCTION_BLOCK FB_State_Snapshot_Manager
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_Trigger_Event  : BOOL; // Сигнал на создание снимка
    VI_Event_Code     : WORD;
    VI_Current_State  : ST_State_Snapshot;
END_VAR
VAR_OUTPUT
    VO_Snapshot_Saved : BOOL;
END_VAR
VAR
    L_Snapshot_Buffer : ARRAY[1..GVL_CONSTANTS.C_MAX_STATE_SNAPSHOTS] OF ST_State_Snapshot;
    L_Write_Idx       : INT := 1;
END_VAR

IF VI_Trigger_Event THEN
    L_Snapshot_Buffer[L_Write_Idx] := VI_Current_State;
    L_Snapshot_Buffer[L_Write_Idx].timestamp_ms := VI_System_Time_MS;
    L_Snapshot_Buffer[L_Write_Idx].trigger_event_code := VI_Event_Code;
    
    L_Write_Idx := (L_Write_Idx MOD GVL_CONSTANTS.C_MAX_STATE_SNAPSHOTS) + 1;
    VO_Snapshot_Saved := TRUE;
ELSE
    VO_Snapshot_Saved := FALSE;
END_IF;
----------------------------------------------------------------------
FILE: FB_State_Snapshot_NVRAM.st
----------------------------------------------------------------------
FUNCTION_BLOCK FB_State_Snapshot_NVRAM
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_Save_Req       : BOOL;
    VI_Snapshot       : ST_State_Snapshot;
END_VAR
VAR_OUTPUT
    VO_Saved          : BOOL;
    VO_Error          : BOOL;
END_VAR
VAR
    L_FileName        : STRING := '/home/root/snapshot.bin';
    L_State           : INT := 0;
    
    // Асинхронные блоки из библиотеки CAA_File
    fbFileOpen        : FILE.Open;
    fbFileWrite       : FILE.Write;
    fbFileClose       : FILE.Close;
    L_FileHandle      : FILE.HANDLE;
END_VAR

CASE L_State OF
    0: // Ожидание
        VO_Saved := FALSE;
        VO_Error := FALSE;
        IF VI_Save_Req THEN
            L_State := 10;
            fbFileOpen(xExecute := FALSE);
            fbFileWrite(xExecute := FALSE);
            fbFileClose(xExecute := FALSE);
        END_IF;
        
    10: // Открытие файла
        fbFileOpen(
            xExecute := TRUE,
            sFileName := L_FileName,
            eFileMode := FILE.MODE.MWRITE
        );
        IF fbFileOpen.xDone THEN
            L_FileHandle := fbFileOpen.hFile;
            fbFileOpen(xExecute := FALSE);
            L_State := 20;
        ELSIF fbFileOpen.xError THEN
            VO_Error := TRUE;
            L_State := 0;
        END_IF;
        
    20: // Запись
        fbFileWrite(
            xExecute := TRUE,
            hFile := L_FileHandle,
            pBuffer := ADR(VI_Snapshot),
            szSize := SIZEOF(VI_Snapshot)
        );
        IF fbFileWrite.xDone THEN
            fbFileWrite(xExecute := FALSE);
            L_State := 30;
        ELSIF fbFileWrite.xError THEN
            VO_Error := TRUE;
            L_State := 30; // Все равно закрываем файл
        END_IF;
        
    30: // Закрытие
        fbFileClose(
            xExecute := TRUE,
            hFile := L_FileHandle
        );
        IF fbFileClose.xDone THEN
            fbFileClose(xExecute := FALSE);
            IF NOT VO_Error THEN
                VO_Saved := TRUE;
            END_IF;
            L_State := 0;
        ELSIF fbFileClose.xError THEN
            VO_Error := TRUE;
            L_State := 0;
        END_IF;
END_CASE;

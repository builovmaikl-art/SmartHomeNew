// ========================================
// Blinds V2 shadow execution (phase2)
// ========================================
fbBlindsV2Staging(
    VI_Blind_ID := 1,
    VI_Enable := TRUE,
    VI_Position_Setpoint := VO_Blinds_Positions[1],
    VI_Manual_Override := (VI_Manual_Blinds_Override[1] > 0),
    VI_Scenario_ID := TO_INT(L_Effective_Scenario),
    VI_Safety_Mode := FALSE,

    VI_Position_Actual := VO_Blinds_Positions[1],
    VI_Manual_Override_Active := (VI_Manual_Blinds_Override[1] > 0),
    VI_Is_Moving := FALSE,
    VI_Alarm_Active := GVL_STATE.G_Lighting_IO_Fault,

    VO_Command_Shadow => L_Blinds_V2_Command_Shadow,
    VO_State_Shadow => L_Blinds_V2_State_Shadow
);

// Blinds validation
IF VO_Blinds_Positions[1] <> L_Blinds_V2_Command_Shadow.Position_Setpoint THEN
    L_Blinds_V2_Shadow_Diff_Found := TRUE;
END_IF;
IF VO_Blinds_Positions[1] <> L_Blinds_V2_State_Shadow.Position_Actual THEN
    L_Blinds_V2_Shadow_Diff_Found := TRUE;
END_IF;


// Guarded Blinds V2 enable
IF L_Blinds_V2_Switch_Enabled THEN
    IF NOT L_Blinds_V2_Shadow_Diff_Found THEN
        L_Blinds_V2_Path_Ready := TRUE;
        L_Blinds_Using_Legacy_Fallback := FALSE;
    ELSE
        L_Blinds_V2_Path_Ready := FALSE;



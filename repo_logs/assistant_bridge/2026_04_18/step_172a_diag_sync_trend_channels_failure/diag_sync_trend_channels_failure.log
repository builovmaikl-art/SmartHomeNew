// === TREND CHANNEL 2 (FLOOR TEMP) ===
IF GVL_Trend.G_Trend_Channel2_Enabled THEN

    GVL_Trend.G_Trend_Buffer_2_Index := GVL_Trend.G_Trend_Buffer_2_Index + 1;

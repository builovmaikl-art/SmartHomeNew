    VI_System_Time_MS : UDINT;
    VI_Save_Req       : BOOL;
    VI_Snapshot       : ST_State_Snapshot;
END_VAR
VAR_OUTPUT
    VO_Saved          : BOOL;
    VO_Error          : BOOL;
END_VAR
VAR

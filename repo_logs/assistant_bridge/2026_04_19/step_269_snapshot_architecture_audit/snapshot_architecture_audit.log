=== 3) SNAPSHOT-RELATED ST FILE HEADERS ===
--- FILE: FB_State_Snapshot_Manager.st (head 220) ---
FUNCTION_BLOCK FB_State_Snapshot_Manager
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_Trigger_Event  : BOOL; // Сигнал на создание снимка
    VI_Event_Code     : WORD;
    VI_Current_State  : ST_State_Snapshot;
END_VAR
VAR_OUTPUT
    VO_Snapshot_Saved : BOOL;
END_VAR
VAR
    L_Snapshot_Buffer : ARRAY[1..GVL_CONSTANTS.C_MAX_STATE_SNAPSHOTS] OF ST_State_Snapshot;
    L_Write_Idx       : INT := 1;
END_VAR

IF VI_Trigger_Event THEN
    L_Snapshot_Buffer[L_Write_Idx] := VI_Current_State;
    L_Snapshot_Buffer[L_Write_Idx].timestamp_ms := VI_System_Time_MS;
    
    // NOTE:
    // ST_State_Snapshot no longer contains trigger_event_code in live project.
    // VI_Event_Code is reserved for future snapshot metadata extension.
    
    L_Write_Idx := (L_Write_Idx MOD GVL_CONSTANTS.C_MAX_STATE_SNAPSHOTS) + 1;
    VO_Snapshot_Saved := TRUE;
ELSE
    VO_Snapshot_Saved := FALSE;
END_IF;
--- FILE: FB_State_Snapshot_NVRAM.st (head 220) ---
FUNCTION_BLOCK FB_State_Snapshot_NVRAM
VAR_INPUT
    VI_System_Time_MS : UDINT;
    VI_Save_Req       : BOOL;
    VI_Snapshot       : ST_State_Snapshot;
END_VAR
VAR_OUTPUT
    VO_Saved          : BOOL;
    VO_Error          : BOOL;
END_VAR
VAR
    L_FileName        : STRING := '/home/root/snapshot.bin';
    L_State           : INT := 0;
    
    // Асинхронные блоки из библиотеки CAA_File
    fbFileOpen        : FILE.Open;
    fbFileWrite       : FILE.Write;
    fbFileClose       : FILE.Close;
    L_FileHandle      : FILE.HANDLE;
END_VAR

CASE L_State OF
    0: // Ожидание
        VO_Saved := FALSE;
        VO_Error := FALSE;
        IF VI_Save_Req THEN
            L_State := 10;
            fbFileOpen(xExecute := FALSE);
            fbFileWrite(xExecute := FALSE);
            fbFileClose(xExecute := FALSE);
        END_IF;
        
    10: // Открытие файла
        fbFileOpen(
            xExecute := TRUE,
            sFileName := L_FileName,
            eFileMode := FILE.MODE.MWRITE
        );
        IF fbFileOpen.xDone THEN
            L_FileHandle := fbFileOpen.hFile;
            fbFileOpen(xExecute := FALSE);
            L_State := 20;
        ELSIF fbFileOpen.xError THEN
            VO_Error := TRUE;
            L_State := 0;
        END_IF;
        
    20: // Запись
        fbFileWrite(
            xExecute := TRUE,
            hFile := L_FileHandle,
            pBuffer := ADR(VI_Snapshot),
            szSize := SIZEOF(VI_Snapshot)
        );
        IF fbFileWrite.xDone THEN
            fbFileWrite(xExecute := FALSE);
            L_State := 30;
        ELSIF fbFileWrite.xError THEN
            VO_Error := TRUE;
            L_State := 30; // Все равно закрываем файл
        END_IF;
        
    30: // Закрытие
        fbFileClose(
            xExecute := TRUE,
            hFile := L_FileHandle
        );
        IF fbFileClose.xDone THEN
            fbFileClose(xExecute := FALSE);
            IF NOT VO_Error THEN
                VO_Saved := TRUE;
            END_IF;
            L_State := 0;
        ELSIF fbFileClose.xError THEN
            VO_Error := TRUE;
            L_State := 0;
        END_IF;
END_CASE;
--- FILE: ST_State_Snapshot.dut (head 220) ---
{attribute 'pack_mode' := '1'}
TYPE ST_State_Snapshot :
STRUCT
    timestamp_ms : UDINT := 0;
    operator_id : STRING(10) := '';
    scenario_id : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    lighting_levels : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHTING_ZONES] OF BYTE;
    floor_heating_setpoints : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF REAL;
    alarm_active : BOOL := FALSE;
    crc32 : DWORD := 0;
END_STRUCT
END_TYPE


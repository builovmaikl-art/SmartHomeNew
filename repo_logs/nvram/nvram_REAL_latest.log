== GVL_PERSISTENT ==
VAR_GLOBAL PERSISTENT RETAIN

    // === SYSTEM ===
    P_System_Mode : E_System_Operating_Mode;

    // === SAFETY LATCHES ===
    P_Safety_Gas_Latched : BOOL;
    P_Safety_Smoke_Latched : BOOL;
    P_Safety_Leak_Latched : BOOL;

    // === HEATING / DHW ===
    P_DHW_Heating_Active : BOOL;

    // === CONTROL ===
    P_Valid : BOOL;

END_VAR

== FB_NVRAM_Manager ==
FUNCTION_BLOCK FB_NVRAM_Manager
VAR_INPUT
    VI_Command                  : BYTE; // 1=WRITE, 2=READ
    VI_Offset                   : UDINT; // Смещение в байтах
    VI_DataRef                  : REFERENCE TO BYTE;
    VI_DataSize                 : UDINT; // КРИТИЧНО: используем этот размер вместо SIZEOF
    VI_System_Time_MS           : UDINT;
    VI_Operator_ID              : STRING(10);
    VI_IsActivePLC              : BOOL;
    VI_TwoPersonConfirmation    : BOOL;
END_VAR
VAR_OUTPUT
    VO_Done                     : BOOL;
    VO_Error                    : BOOL;
    VO_ErrorID                  : UDINT;
    // VO_ReadDataRef removed (REFERENCE TO not allowed in output)
    VO_HMI_Status_Message       : STRING(200);
END_VAR
VAR
    L_prev_Command              : BYTE;
    L_cmd_rising                : BOOL;
    L_i                         : UDINT;
    L_Last_Write_Time_MS        : UDINT := 0; // Время последней записи
    L_Data_Changed              : BOOL; // Флаг изменения данных
    L_pData                      : POINTER TO BYTE;
END_VAR
VAR CONSTANT
    C_MAX_NVRAM_SIZE            : UDINT := 12800;
END_VAR

// Детекция фронта команды
L_cmd_rising := (VI_Command <> 0) AND (L_prev_Command = 0);
L_prev_Command := VI_Command;

IF L_cmd_rising THEN
    VO_Done := FALSE;
    VO_Error := FALSE;
    VO_ErrorID := 0;
    VO_HMI_Status_Message := '';
    
    // Валидация смещения
    IF VI_Offset >= C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#1501;
        VO_HMI_Status_Message := 'NVRAM: Неверное смещение';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    // Валидация указателя
    IF NOT __ISVALIDREF(VI_DataRef) THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150A;
        VO_HMI_Status_Message := 'NVRAM: Недействительная ссылка на данные';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    L_pData := ADR(VI_DataRef);

    IF (VI_Offset + VI_DataSize) > C_MAX_NVRAM_SIZE THEN
        VO_Error := TRUE;
        VO_ErrorID := 16#150B;
        VO_HMI_Status_Message := 'NVRAM: Размер данных превышает доступный объем';
        VO_Done := TRUE;
        RETURN;
    END_IF;

    IF VI_Command = 1 THEN // ЗАПИСЬ (WRITE)
        IF NOT VI_IsActivePLC THEN
            VO_Error := TRUE;
            VO_ErrorID := 16#1509;
            VO_HMI_Status_Message := 'NVRAM: Запись запрещена (STANDBY)';
        ELSE
            // Ограничение частоты записи (не чаще 1 раза в 60 секунд)
            IF (VI_System_Time_MS - L_Last_Write_Time_MS) < 60000 AND L_Last_Write_Time_MS <> 0 THEN
                VO_Error := TRUE;
                VO_ErrorID := 16#150C;
                VO_HMI_Status_Message := 'NVRAM: Превышена частота записи (лимит 1 раз в 60с)';
            ELSE
                // Проверка на изменение данных перед записью
                L_Data_Changed := FALSE;
                IF TRUE THEN
                    L_Data_Changed := TRUE;
                END_IF;
                
                IF L_Data_Changed THEN
                    // Безопасное копирование (WRITE)
                    FOR L_i := 0 TO VI_DataSize - 1 DO
                        GVL_Retain.G_NVRAM_Data[VI_Offset + L_i] := L_pData[L_i];
                    END_FOR;
                    L_Last_Write_Time_MS := VI_System_Time_MS;
                    VO_HMI_Status_Message := 'NVRAM: Данные успешно сохранены в RETAIN';
                ELSE
                    VO_HMI_Status_Message := 'NVRAM: Данные не изменились, запись пропущена';
                END_IF;
            END_IF;
        END_IF;
        VO_Done := TRUE;
        
    ELSIF VI_Command = 2 THEN // ЧТЕНИЕ (READ)
        // Безопасное копирование (READ)
        FOR L_i := 0 TO VI_DataSize - 1 DO
            L_pData[L_i] := GVL_Retain.G_NVRAM_Data[VI_Offset + L_i];
        END_FOR;
        VO_HMI_Status_Message := 'NVRAM: Данные успешно прочитаны из RETAIN';
        VO_Done := TRUE;
    END_IF;
END_IF;

IF VI_Command = 0 THEN
    VO_Done := FALSE;
END_IF;

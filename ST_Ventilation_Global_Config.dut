{attribute 'pack_mode' := '1'}
TYPE ST_Ventilation_Global_Config :
STRUCT
    enable_ventilation : BOOL := TRUE;
    total_units : BYTE := 8;
    default_supply_speed : BYTE := 40;
    default_exhaust_speed : BYTE := 40;
    Degraded_Exhaust_Limit : BYTE := 30; // Ограничение вытяжки в режиме DEGRADED
    Scenario_Modes : ARRAY[1..GVL_CONSTANTS.C_MAX_SCENARIOS] OF ST_Ventilation_Scenario_Mode;
    wet_zone_to_exhaust_map : ARRAY[1..GVL_CONSTANTS.C_MAX_WET_ZONES] OF INT := [2, 3, 4, 5]; // Привязка мокрых зон к вытяжным вентиляторам
    pv3_exhaust_index : INT := 3; // Индекс вытяжного вентилятора ПВ-3
END_STRUCT
END_TYPE\n// VENT_POLICY_APPLIED
PolicyApplied : BOOL := TRUE;

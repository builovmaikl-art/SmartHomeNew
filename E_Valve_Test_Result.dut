{attribute 'strict'}
TYPE E_Valve_Test_Result :
(
    TEST_RESULT_NONE := 0,
    TEST_RESULT_PASSED := 1,
    TEST_RESULT_CURRENT_DEVIATION := 2,
    TEST_RESULT_TIME_DEVIATION := 3,
    TEST_RESULT_STALL := 4,
    TEST_RESULT_LIMIT_SWITCH_FAIL := 5,
    TEST_RESULT_ABORTED := 6
) USINT;
END_TYPE
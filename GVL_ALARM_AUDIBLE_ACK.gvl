{attribute 'qualified_only'}
VAR_GLOBAL
    G_Ack_Request : BOOL := FALSE;
    G_Ack_Active : BOOL := FALSE;
    G_Ack_Expires_MS : UDINT := 0;
    G_Ack_Remaining_MS : UDINT := 0;
    G_Ack_Count_Current_Alarm : INT := 0;
    G_Ack_Limit_Reached : BOOL := FALSE;
    G_Last_Ack_Accepted : BOOL := FALSE;
    G_Last_Ack_Denied : BOOL := FALSE;
    G_Last_Denial_Code : UINT := 0;
    G_Last_Event_MS : UDINT := 0;
    G_Status_Text : STRING(200) := '';
END_VAR

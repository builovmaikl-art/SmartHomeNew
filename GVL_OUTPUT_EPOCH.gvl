VAR_GLOBAL
    // ======================================================
    // OUTPUT PUBLICATION AUTHORITY STATE
    // ======================================================
    // Centralized final physical publication arbitration state.
    //
    // Output_Forced_Safe_Decay is the final output hard-stop
    // authority exported to IO_Write.
    //
    // Output_Publication_Valid / lease / stale fields are
    // derived publication diagnostics and observability state.
    // They must not be reinterpreted by IO_Write as separate
    // hard-stop authorities.
    // ======================================================

    Output_Publication_Epoch : ULINT := 0;
    Output_Publication_Valid : BOOL := FALSE;

    Output_Lease_Active : BOOL := FALSE;
    Output_Lease_Expired : BOOL := FALSE;
    Output_Lease_Timeout_MS : UDINT := 3000;

    Output_Last_Publication_MS : UDINT := 0;
    Output_Last_Refresh_MS : UDINT := 0;
    Output_Last_Invalidation_MS : UDINT := 0;

    Output_Runtime_Epoch : ULINT := 0;
    Output_Runtime_Epoch_Valid : BOOL := FALSE;

    Output_Stale_Detected : BOOL := FALSE;
    Output_Forced_Safe_Decay : BOOL := FALSE;

    // Advisory-only semantic continuity visibility.
    // Does not hard-stop physical output publication.
    Output_Semantic_Continuity_Warning : BOOL := FALSE;

    Output_Last_Error_Code : UDINT := 0;
    Output_Last_Error_Text : STRING(160) := '';
END_VAR
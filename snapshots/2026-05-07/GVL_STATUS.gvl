{attribute 'qualified_only'}
VAR_GLOBAL
    G_System_Time_MS : UDINT;
    G_Last_System_Time_MS : UDINT := 0;
    G_Time_Of_Day_MS : UDINT := 0;
    G_Current_Day : UINT := 1;
    G_Day_Of_Year : UINT := 1;
    G_Current_TOD : TOD;
    G_Current_Scenario : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    G_Previous_Scenario : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    G_Is_Night : BOOL;
    G_PLC_ID : BYTE := 1;
    G_Is_Active_PLC : BOOL;
    G_Other_PLC_Is_Active : BOOL;

    G_Remote_PLC_Last_Seen_MS : UDINT;
    G_Remote_PLC_Alive : BOOL;

    G_Local_PLC_ID : BYTE := 1;
    G_Active_PLC_ID : BYTE := 1;
    G_Remote_PLC_Pulse : BOOL;

    G_Security_Status_Msg : STRING(200);
    G_Gas_Status_Msg : STRING(200);
    G_Flood_Status_Msg : STRING(200);
    G_Vent_Status_Msg : STRING(200);

    G_DHW_Status : ST_DHW_Status;
    G_Manifold_Status : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF ST_Manifold_Status;
    G_Boiler_Status : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF ST_Boiler_Status;

    G_IO_Modules_Online : ARRAY[1..GVL_CONSTANTS.C_MAX_MODULES] OF BOOL;

    G_Sim_Active : BOOL;
    G_Wet_Zone_Light_Active : BOOL;

    G_System_Mode_Msg : STRING(200);
    G_System_Mode_Cause : STRING(200);
    G_System_Mode_Text : STRING(200);

    G_Evac_Target_Zone_Name : STRING(80);
    G_Evac_Hazard_Zone_Name : STRING(80);

    G_Diagnostics : ST_System_Diagnostics;
    G_Diagnostics_Events : ARRAY[1..50] OF ST_Diagnostic_Event;
    G_Diagnostics_Count : INT := 0;
END_VAR
{attribute 'pack_mode' := '1'}
TYPE ST_User_Rule :
STRUCT
    Enabled : BOOL;
    Condition_Type : E_Rule_Condition_Type;
    Condition_Target_ID : BYTE; // ID зоны или датчика
    Condition_Op : E_Rule_Comparison;
    Condition_Value : REAL;
    Condition_Value_Max : REAL; // Для COMP_IN_RANGE
    Action_Target_ID : BYTE;
    Action_Value : REAL;
    Action_Type : E_Rule_Action_Type;
    Priority : BYTE;
END_STRUCT
END_TYPE
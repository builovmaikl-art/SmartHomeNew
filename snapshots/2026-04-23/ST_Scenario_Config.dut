{attribute 'pack_mode' := '1'}
TYPE ST_Scenario_Config :
STRUCT
    scenario_id : E_SCENARIO_TYPE;
    lighting_level_base : BYTE := 100;
    lighting_level_accent : BYTE := 100;
    floor_heating_adjust_celsius : REAL := 0.0;
    ventilation_speed_percent : BYTE := 50;
    sockets_enabled : BOOL := TRUE;
    blinds_position_percent : BYTE := 0;
    Presence_Simulation_Enabled : BOOL := FALSE;
END_STRUCT
END_TYPE
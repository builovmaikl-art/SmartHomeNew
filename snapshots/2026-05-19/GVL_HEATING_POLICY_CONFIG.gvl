{attribute 'qualified_only'}
VAR_GLOBAL
    G_Guest_Preheat_Enabled : BOOL := TRUE;
    G_Guest_Preheat_Priority_Boost : INT := 2;
    G_Guest_Preheat_Max_Duration_MS : UDINT := 7200000;

    // HMI-configurable schedule (per zone, up to 3 events)
    G_Zone_Schedule : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES, 1..3] OF ST_Heating_Schedule_Event;
END_VAR

{attribute 'strict'}
TYPE E_Rule_Action_Type :
(
    ACTION_NONE := 0,
    ACTION_SET_FLOOR_HEATING := 1,
    ACTION_SET_LIGHTING_BASE := 2,
    ACTION_SET_LIGHTING_ACCENT := 3,
    ACTION_SET_SOCKET := 4,
    ACTION_SET_VENTILATION := 5,
    ACTION_SET_BLINDS := 6,
    ACTION_ACTIVATE_SCENARIO := 7,
    ACTION_TOGGLE_LIGHTING := 8,
    ACTION_TOGGLE_SOCKET := 9
) USINT;
END_TYPE
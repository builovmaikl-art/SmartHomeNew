    // Temporal authority.
    Semantic_Preservation_Last_Update_MS : UDINT := 0;
    Semantic_Preservation_Lease_Expired : BOOL := TRUE;

    // Diagnostics.
    Semantic_Preservation_Last_Error_Code : UDINT := 0;
    Semantic_Preservation_Last_Error_Text : STRING(160) := '';
    Semantic_Preservation_Invalidation_Count : UDINT := 0;
END_VAR
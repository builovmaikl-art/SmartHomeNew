{attribute 'pack_mode' := '1'}
TYPE ST_FloorHeating_Circuit_Config :
STRUCT
    circuit_id : BYTE := 0;
    zone : BYTE := 0;
    manifold_id : BYTE := 1; // ID коллектора, к которому подключен контур
    sensor_id : BYTE := 1; // ID датчика температуры
    valve_id : BYTE := 1; // ID клапана
    control_type : BYTE := 1; // 0: по полу, 1: по воздуху
    design_temp : REAL := 35.0;
    min_temp : REAL := 20.0;
    max_temp : REAL := 45.0;
    pid_kp : REAL := 2.0;
    pwm_period_s : UINT := 600; // Период ШИМ в секундах (по умолчанию 10 минут)
END_STRUCT
END_TYPE
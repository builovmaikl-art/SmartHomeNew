{attribute 'pack_mode' := '1'}
TYPE ST_History_Record :
STRUCT
    timestamp_ms : UDINT := 0;
    event_code : WORD := 0;
    event_value : REAL := 0.0;
    unit : BYTE := 0;
    zone_id : BYTE := 0;
    operator_id : STRING(10) := '';
    priority : E_ALERT_PRIORITY := E_ALERT_PRIORITY.ALERT_PRIORITY_NONE;
END_STRUCT
END_TYPE
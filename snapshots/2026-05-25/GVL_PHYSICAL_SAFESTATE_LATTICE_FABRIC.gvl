    // Canonical safe-state topology proofs.
    Canonical_SafeState_Topology_Valid : BOOL := FALSE;
    Physical_SafeState_Lattice_Coherent : BOOL := FALSE;
    Deterministic_FailSafe_Convergence_Granted : BOOL := FALSE;
    SafeState_Energy_Boundary_Stable : BOOL := FALSE;
    SafeState_Physical_Risk_Bounded : BOOL := FALSE;

    // Domain safe-state compatibility.
    Heating_SafeState_Compatible : BOOL := FALSE;
    Water_SafeState_Compatible : BOOL := FALSE;
    Ventilation_SafeState_Compatible : BOOL := FALSE;
    Access_SafeState_Compatible : BOOL := FALSE;
    Lighting_SafeState_Compatible : BOOL := FALSE;

    // Physical safe-state convergence validators.
    Thermal_SafeState_Stable : BOOL := FALSE;
    Hydraulic_SafeState_Stable : BOOL := FALSE;
    Airflow_SafeState_Stable : BOOL := FALSE;
    Occupancy_SafeState_Stable : BOOL := FALSE;
    Residual_Actuation_Safe : BOOL := FALSE;

    // Safe-state ambiguity detectors.
    SafeState_Ambiguity_Detected : BOOL := FALSE;

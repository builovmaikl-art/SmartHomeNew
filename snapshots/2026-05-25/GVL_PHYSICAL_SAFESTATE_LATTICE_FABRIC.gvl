    // Diagnostics.
    Physical_SafeState_Lattice_Last_Error_Code : UDINT := 0;
    Physical_SafeState_Lattice_Last_Error_Text : STRING(160) := '';
    Physical_SafeState_Lattice_Invalidation_Count : UDINT := 0;

{attribute 'qualified_only'}
VAR_GLOBAL
    // Deterministic command arbitration buffer.
    // Owned by PRG_Command_Arbitration and its phase programs only.

    B_Mode : E_Safety_Mode := NORMAL;
    B_Safety_Active : BOOL := FALSE;
    B_User_Access_OK : BOOL := FALSE;

    B_Role_Conflict_Active : BOOL := FALSE;
    B_PLC_Inactive_Active : BOOL := FALSE;

    B_Gas_Valve_Close : BOOL := FALSE;
    B_Boiler_Stop : BOOL := FALSE;
    B_Supply_100_Req : BOOL := FALSE;
    B_Supply_80_Req : BOOL := FALSE;
    B_Vent_PV3_Boost : BOOL := FALSE;
    B_Exhaust_100_Req : BOOL := FALSE;
    B_Vent_Stop : BOOL := FALSE;
    B_Vent_Block : BOOL := FALSE;
    B_Vent_Smoke_Exhaust : BOOL := FALSE;

    B_Heating_Block : BOOL := FALSE;
    B_Heating_Emergency_Stop : BOOL := FALSE;
    B_Heating_Gas_Safety_Stop : BOOL := FALSE;

    B_Water_Block : BOOL := FALSE;
    B_Water_Emergency_Stop : BOOL := FALSE;
    B_Close_Valve_35 : BOOL := FALSE;
    B_Close_Valve_36 : BOOL := FALSE;

    B_Lock_1_Open : BOOL := FALSE;
    B_Lock_1_Close : BOOL := FALSE;
    B_Lock_2_Open : BOOL := FALSE;
    B_Lock_2_Close : BOOL := FALSE;
    B_Gate_Open : BOOL := FALSE;
    B_Wicket_Open : BOOL := FALSE;
END_VAR

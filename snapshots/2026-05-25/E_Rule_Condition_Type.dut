{attribute 'strict'}
TYPE E_Rule_Condition_Type :
(
    COND_NONE := 0,
    COND_AIR_TEMP := 1,
    COND_FLOOR_TEMP := 2,
    COND_HUMIDITY := 3,
    COND_CO2 := 4,
    COND_METHANE := 5,
    COND_CO := 6,
    COND_DOOR_WINDOW := 7,
    COND_FLOOD := 8,
    COND_SMOKE := 9,
    COND_MOTION := 10,
    COND_TIME_OF_DAY := 11,
    COND_DAY_OF_WEEK := 12
) USINT;
END_TYPE
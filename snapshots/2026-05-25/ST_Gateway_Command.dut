{attribute 'pack_mode' := '1'}
TYPE ST_Gateway_Command :
STRUCT
    command_id : UDINT;
    timestamp_ms : UDINT;
    operator_id : STRING(10);
    command_type : E_Gateway_Command_Type;
    target_zone : BYTE;
    target_value : REAL;
    target_on_off : BOOL;
    target_scenario : E_SCENARIO_TYPE;
    target_armed : BOOL;
    target_pin : STRING(4);
    target_2fa_code : STRING(6);
    telegram_msg : STRING(200);
    source_ip : STRING(15); // IP-адрес источника команды для проверки безопасности
    crc32 : DWORD;
END_STRUCT
END_TYPE
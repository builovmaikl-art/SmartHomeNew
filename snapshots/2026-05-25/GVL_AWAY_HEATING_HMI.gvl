{attribute 'qualified_only'}
VAR_GLOBAL
    // HMI surface for per-circuit comfort/economy/away heating profile.
    G_Set_Circuit_Profile_Req : BOOL := FALSE;
    G_Profile_Circuit : INT := 0;
    G_Profile_Use_In_Normal : BOOL := TRUE;
    G_Profile_Use_In_Away_Preheat : BOOL := TRUE;
    G_Profile_Comfort_Temp : REAL := 22.0;
    G_Profile_Economy_Temp : REAL := 17.0;
    G_Profile_Long_Away_Temp : REAL := 12.0;

    // HMI surface for planned return.
    // Delay is relative to current monotonic PLC time, in hours.
    G_Set_Planned_Return_Req : BOOL := FALSE;
    G_Clear_Planned_Return_Req : BOOL := FALSE;
    G_Planned_Return_Enabled : BOOL := FALSE;
    G_Planned_Return_Delay_Hours : REAL := 0.0;
    G_Preheat_Lead_Hours : REAL := 3.0;
    G_Return_Grace_Hours : REAL := 24.0;

    G_Last_Status_Text : STRING(200) := '';
    G_Last_Error : BOOL := FALSE;
    G_Last_Update_MS : UDINT := 0;
END_VAR
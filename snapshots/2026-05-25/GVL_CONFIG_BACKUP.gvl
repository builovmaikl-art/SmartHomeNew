{attribute 'qualified_only'}
VAR_GLOBAL
    // Full runtime snapshot of configuration values that can be restored
    // after validation or calibration faults. File/gateway archival remains
    // a separate porting-stage concern via GVL_FILE_ARCHIVE.

    G_Backup_FloorHeating_Configs : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF ST_FloorHeating_Circuit_Config;

    G_Backup_Max_Active_Manifolds : INT := 0;
    G_Backup_Max_Thermal_Budget : REAL := 0.0;

    // Sensor calibration backup. Calibration records are configuration data:
    // invalid active calibration must be recoverable by PRG_Config_Versioning.
    G_Backup_Calib_Outdoor_Temp : ST_Sensor_Calibration_Record;
    G_Backup_Calib_Ambient_Lux : ST_Sensor_Calibration_Record;
    G_Backup_Calib_Supply_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_SUPPLY_TEMPS] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Room_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Floor_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_CO2 : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Humidity : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Manifold_T_Supply : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Manifold_T_Return : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_Methane : ARRAY[1..GVL_CONSTANTS.C_MAX_METHANE_SENSORS] OF ST_Sensor_Calibration_Record;
    G_Backup_Calib_CO : ARRAY[1..GVL_CONSTANTS.C_MAX_CO_SENSORS] OF ST_Sensor_Calibration_Record;

    // Integrity flag
    G_Backup_Valid : BOOL := FALSE;
END_VAR

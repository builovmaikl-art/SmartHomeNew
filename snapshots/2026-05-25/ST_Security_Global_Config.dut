{attribute 'pack_mode' := '1'}
TYPE ST_Security_Global_Config :
STRUCT
    PIN_Code : STRING(4) := '1234';
    Phones : ARRAY[1..GVL_CONSTANTS.C_MAX_SECURITY_PHONES] OF STRING(15);

    // Время на ввод PIN после нарушения периметра.
    // entry_delay_seconds оставлен как совместимое имя, pin_entry_timeout_seconds — явная настройка HMI.
    entry_delay_seconds : UDINT := 45;
    pin_entry_timeout_seconds : UDINT := 45;

    // Время выхода после постановки на охрану.
    exit_delay_seconds : UDINT := 60;

    alarm_duration_seconds : UDINT := 180;
    two_person_timeout_seconds : UDINT := 120;
    max_access_attempts : BYTE := 3;

    // Комбинированная тревога: 2 и более независимых датчика за окно времени — тревога без задержки.
    combined_alarm_window_seconds : UDINT := 10;

    // Краткосрочная охрана с открытыми окнами.
    // Двери всё равно блокируют постановку. Разрешённые открытые окна игнорируются
    // до первого закрытия и не дают тревогу при автоматическом повышении уровня отъезда.
    allow_short_away_open_windows : BOOL := FALSE;

    auto_arm_enabled : BOOL := FALSE;
    auto_arm_time_ms : UDINT := 0;
    enable_2fa : BOOL := TRUE; // Включение/отключение двухфакторной аутентификации
    gate_open_pulse_ms : UDINT := GVL_CONSTANTS.C_MS_IN_SECOND;
    wicket_open_pulse_ms : UDINT := GVL_CONSTANTS.C_MS_IN_SECOND;
    lock_open_pulse_ms : UDINT := GVL_CONSTANTS.C_MS_IN_SECOND;
    lock_close_pulse_ms : UDINT := GVL_CONSTANTS.C_MS_IN_SECOND;
    
    // Байпасы зон
    bypass_motion : ARRAY[1..16] OF BOOL;
    bypass_doors : ARRAY[1..GVL_CONSTANTS.C_MAX_DOOR_SENSORS] OF BOOL;
    bypass_windows : ARRAY[1..16] OF BOOL;
END_STRUCT
END_TYPE
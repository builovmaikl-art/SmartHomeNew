PROGRAM PRG_Command_Arbitration_Phase_01_Reset_Role
// Command arbitration phase 01: reset deterministic buffer and handle PLC role gates.
// Preserves old priority 1/2 early-exit semantics through buffer flags.

GVL_COMMAND_ARBITRATION_BUFFER.B_Mode := GVL_SAFETY_SHUTDOWN.G_Safety_Mode;
GVL_COMMAND_ARBITRATION_BUFFER.B_Safety_Active := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_User_Access_OK := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Role_Conflict_Active := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_PLC_Inactive_Active := FALSE;

GVL_COMMAND_ARBITRATION_BUFFER.B_Gas_Valve_Close := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Supply_100_Req := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Supply_80_Req := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_PV3_Boost := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Exhaust_100_Req := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Block := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Smoke_Exhaust := FALSE;

GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Gas_Safety_Stop := FALSE;

GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 := FALSE;

GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_1_Open := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_1_Close := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_2_Open := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Lock_2_Close := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Gate_Open := FALSE;
GVL_COMMAND_ARBITRATION_BUFFER.B_Wicket_Open := FALSE;

IF GVL_STATUS.G_Is_Active_PLC AND GVL_STATUS.G_Other_PLC_Is_Active THEN
    GVL_HEALTH_BRIDGE.G_Role_Conflict_Error := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Role_Conflict_Active := TRUE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Gas_Valve_Close := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Block := TRUE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Gas_Safety_Stop := TRUE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 := TRUE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 := TRUE;

ELSIF NOT GVL_STATUS.G_Is_Active_PLC THEN
    GVL_COMMAND_ARBITRATION_BUFFER.B_PLC_Inactive_Active := TRUE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Gas_Valve_Close := GVL_COMMAND_POLICY_CONFIG.G_PLC_Inactive_Close_Gas;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Boiler_Stop := GVL_COMMAND_POLICY_CONFIG.G_PLC_Inactive_Stop_Boiler;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Stop := GVL_COMMAND_POLICY_CONFIG.G_PLC_Inactive_Stop_Vent;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Vent_Block := FALSE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Block := GVL_COMMAND_POLICY_CONFIG.G_PLC_Inactive_Block_Heating;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Emergency_Stop := FALSE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Heating_Gas_Safety_Stop := FALSE;

    GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Block := GVL_COMMAND_POLICY_CONFIG.G_PLC_Inactive_Block_Water;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Water_Emergency_Stop := FALSE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_35 := FALSE;
    GVL_COMMAND_ARBITRATION_BUFFER.B_Close_Valve_36 := FALSE;
END_IF;

// >>> BULK_SYNC_ANCHOR: PRG_Command_Arbitration_Phase_01_Reset_Role <<<
END_PROGRAM

(
  SENSOR_TYPE_NONE := 0,
  SENSOR_TYPE_DOOR_WINDOW := 5,
  SENSOR_TYPE_GLASS_BREAK := 6,
  SENSOR_TYPE_FLOOD := 7,
  SENSOR_TYPE_SMOKE := 8,
  SENSOR_TYPE_GAS_METHANE := 1,
  SENSOR_TYPE_GAS_CO := 2,
  SENSOR_TYPE_TEMP_FLOOR := 3,
  SENSOR_TYPE_TEMP_AIR := 4,
  SENSOR_TYPE_CO2 := 9
) USINT;
END_TYPE
{attribute 'qualified_only'}
VAR_GLOBAL
    // Runtime buffer owned by PRG_Lighting and its phase programs only.

    B_Manual_Light_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BYTE;
    B_Manual_Blinds_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BYTE;
    B_Manual_Socket_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;

    B_Sim_Lights : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BOOL;
    B_Physical_Switches : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BOOL;
    B_Motion_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BOOL;
    B_Blinds_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_BLINDS] OF BYTE;
    B_Socket_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;
    B_Wet_Zone_Light_Active : ARRAY[1..GVL_CONSTANTS.C_MAX_WET_ZONES] OF BOOL;

    B_Fire_Alarm_Active : BOOL := FALSE;
    B_Flood_Alarm_Active : BOOL := FALSE;
    B_Security_Armed : BOOL := FALSE;
    B_Security_Alarm : BOOL := FALSE;
    B_Evac_Blink_On : BOOL := FALSE;

    B_Distributed_Execute_Allowed : BOOL := FALSE;
    B_Distributed_Projection_Allowed : BOOL := FALSE;
    B_Emergency_Lighting_Override : BOOL := FALSE;
END_VAR

{attribute 'pack_mode' := '1'}
TYPE ST_Ventilation_Scenario_Mode :
STRUCT
  Scenario_ID : BYTE;
  Scenario_Priority : BYTE;
  Fire_Alarm : BOOL;
  Methane_Alarm : BOOL;
  Smoke_Detected : BOOL;
  Exhaust_Modes : ARRAY[1..GVL_CONSTANTS.C_MAX_EXHAUST_FANS] OF BYTE;
  Supply_Modes : ARRAY[1..GVL_CONSTANTS.C_MAX_SUPPLY_FANS] OF BYTE;
  Base_Fan_Speed : BYTE := 50;
  Target_Temp : REAL := 22.0;
END_STRUCT
END_TYPE
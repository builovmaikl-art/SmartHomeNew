TYPE ST_OpenTherm_Register_Map :
STRUCT
    // Register offsets inside one boiler adapter block.
    // Real Modbus device addressing is configured by Base_Register + offsets.
    Base_Register : UINT;
    Cmd_Enable_Offset : UINT;
    Cmd_Setpoint_x10_Offset : UINT;
    Cmd_Seq_Lo_Offset : UINT;
    Cmd_Seq_Hi_Offset : UINT;

    Status_Heartbeat_Lo_Offset : UINT;
    Status_Heartbeat_Hi_Offset : UINT;
    Status_Ack_Seq_Lo_Offset : UINT;
    Status_Ack_Seq_Hi_Offset : UINT;
    Status_Word_Offset : UINT;
    Error_Code_Offset : UINT;
    Modulation_x10_Offset : UINT;
    Boiler_Temp_x10_Offset : UINT;
END_STRUCT
END_TYPE

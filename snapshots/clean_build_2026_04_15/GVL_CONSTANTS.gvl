{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    // Размеры массивов (конфигурация системы)
    C_MAX_ZONES            : INT := 16; // Максимальное количество зон (комнат)
    C_MAX_LIGHTING_ZONES   : INT := 32; // Алиас для контуров освещения
    C_MAX_HEATING_CIRCUITS : INT := 8;  // Алиас для контуров отопления
    C_MAX_CLIMATE_ZONES    : INT := 16; // Алиас для климатических зон
    C_MAX_LIGHT_ZONES      : INT := 32; // Алиас для световых зон
    C_MAX_SOCKETS          : INT := 36; // Максимальное количество управляемых розеток
    C_MAX_BLINDS           : INT := 20; // Максимальное количество штор/жалюзи
    C_MAX_ALARMS           : INT := 20; // Максимальное количество активных тревог
    C_MAX_RULES            : INT := 20; // Максимальное количество правил (движок правил)
    C_MAX_MANIFOLDS        : INT := 5;  // Максимальное количество коллекторов
    C_MAX_BOILERS          : INT := 2;  // Максимальное количество котлов
    C_MAX_SUPPLY_FANS      : INT := 3;  // Максимальное количество приточных вентиляторов
    C_MAX_EXHAUST_FANS     : INT := 5;  // Максимальное количество вытяжных вентиляторов
    C_MAX_SECURITY_SENSORS : INT := 15; // Максимальное количество датчиков безопасности (герконы, стекло)
    C_MAX_FLOOD_SENSORS    : INT := 12; // Максимальное количество датчиков протечки
    C_MAX_DOOR_SENSORS     : INT := 8;  // Максимальное количество датчиков дверей
    C_MAX_CO_SENSORS       : INT := 8;  // Максимальное количество датчиков CO
    C_MAX_METHANE_SENSORS  : INT := 2;  // Максимальное количество датчиков метана
    C_MAX_VENT_UNITS       : INT := 8;  // Максимальное количество вентустановок
    C_MAX_SUPPLY_TEMPS     : INT := 2;  // Максимальное количество датчиков температуры притока
    C_MAX_SMOKE_SENSORS    : INT := 6;  // Максимальное количество датчиков дыма
    C_MAX_SCENARIOS        : INT := 6;  // Максимальное количество сценариев
    C_MAX_OUTDOOR_ZONES    : INT := 4;  // Максимальное количество зон уличного освещения
    C_MAX_ACCESS_CODES     : INT := 10; // Максимальное количество кодов доступа
    C_MAX_WET_ZONES        : INT := 4;  // Максимальное количество "мокрых" зон (санузлы)
    C_MAX_CALIBRATIONS     : INT := 20; // Максимальное количество калибровок датчиков
    C_MAX_MODULES          : INT := 10; // Максимальное количество модулей ввода-вывода
    C_MAX_CLEANING_MODES   : INT := 3;  // Максимальное количество режимов уборки
    C_MAX_ALLOWED_IPS      : INT := 5;  // Максимальное количество разрешенных IP-адресов
    C_MAX_VENT_SUPPLY_MODES: INT := 3;  // Максимальное количество режимов притока вентиляции
    C_MAX_SECURITY_PHONES  : INT := 5;  // Максимальное количество телефонов для оповещения
    C_MAX_FLOOD_VALVES     : INT := 3;  // Максимальное количество кранов защиты от протечек
    C_MAX_HUMIDITY_SENSORS : INT := 8;  // Максимальное количество датчиков влажности
    C_MAX_CO2_SENSORS      : INT := 8;  // Максимальное количество датчиков CO2
    C_MAX_CIRCUITS_PER_MANIFOLD : INT := 4; // Максимальное количество контуров на коллектор
    C_MAX_TREND_DATA_POINTS: INT := 100; // Максимальное количество точек данных для трендов
    C_MAX_HISTORY_RECORDS  : INT := 100; // Максимальное количество записей в истории
    C_MAX_DEBUG_LOGS       : INT := 1000; // Максимальное количество записей в логе отладки
    C_MAX_GATEWAY_COMMANDS : INT := 10; // Максимальное количество команд в буфере шлюза
    C_MAX_STATE_SNAPSHOTS  : INT := 10; // Максимальное количество снимков состояния
    C_MAX_BLACKBOX_RECORDS : INT := 100; // Максимальное количество записей черного ящика
    C_MAX_PRESENCE_HISTORY : INT := 1008; // Максимальное количество записей истории присутствия
    C_MAX_MODBUS_REGISTERS : INT := 201; // Максимальное количество регистров Modbus
    C_MAX_DEDUPLICATION_HISTORY : INT := 100; // Максимальное количество записей истории дедупликации
    C_MAX_NVRAM_RECORDS    : INT := 100; // Максимальное количество записей NVRAM
    C_MAX_NVRAM_DATA       : INT := 128; // Максимальный размер данных NVRAM
    
    // Аналоговые входы (4-20mA, 0-10V)
    C_ANALOG_RAW_MAX       : WORD := 27648; // Максимальное значение АЦП (100%)
    C_ANALOG_4MA_RAW       : WORD := 5529;  // Значение АЦП для 4mA (20% от 27648)
    C_ANALOG_3_6MA_RAW     : WORD := 4976;  // Порог обрыва NAMUR NE43 (< 3.6mA)
    C_ANALOG_21MA_RAW      : WORD := 29030; // Порог КЗ NAMUR NE43 (> 21mA)
    C_ANALOG_10V_MAX_RAW   : WORD := 30000; // Порог выхода за пределы 0-10V
    
    // Временные константы (в миллисекундах)
    C_MS_IN_SECOND         : UDINT := 1000;
    C_MS_IN_MINUTE         : UDINT := 60000;
    C_MS_IN_HOUR           : UDINT := 3600000;
    C_MS_IN_DAY            : UDINT := 86400000;
    
    // Пороги мощности для каскада котлов (0..500%)
    C_BOILER_CASCADE_MIN_DEMAND : REAL := 25.0; // Минимальный запрос для включения ведущего котла (5% от одного коллектора)
    C_BOILER_CASCADE_HIGH_DEMAND : REAL := 250.0; // Высокий запрос для включения второго котла (50% от общей мощности)
END_VAR
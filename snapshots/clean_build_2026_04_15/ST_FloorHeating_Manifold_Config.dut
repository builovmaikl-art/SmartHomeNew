{attribute 'pack_mode' := '1'}
TYPE ST_FloorHeating_Manifold_Config :
STRUCT
    manifold_id : BYTE;
    location : STRING(30);
    nominal_flow : REAL;
    enable_pump : BOOL;
    circuits : ARRAY[1..GVL_CONSTANTS.C_MAX_CIRCUITS_PER_MANIFOLD] OF ST_FloorHeating_Circuit_Config;
END_STRUCT
END_TYPE
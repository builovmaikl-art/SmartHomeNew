{attribute 'pack_mode' := '1'}
TYPE ST_Device_Health :
STRUCT
    Health_Score : BYTE := 100;
    Total_Runtime_Hours : UDINT;
    Starts_Count : UDINT;
    Last_Start_Current : REAL;
    Avg_Start_Current : REAL;
    Sample_Count : UDINT;
    Current_Sum : REAL;
    Maintenance_Required : BOOL;
    Warning_Message : STRING(50);
END_STRUCT
END_TYPE
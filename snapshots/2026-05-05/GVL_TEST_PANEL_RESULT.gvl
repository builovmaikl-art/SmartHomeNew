{attribute 'qualified_only'}
VAR_GLOBAL
    // === RESULT VIEW ONLY ===
    G_Enable : BOOL := FALSE;
    G_Scenario_ID : INT := 0;
    G_Scenario_Run : BOOL := FALSE;
    G_Scenario_Active : BOOL := FALSE;

    G_Test_Result_Line : STRING(200) := 'Idle';
    G_Result_Passed : BOOL := FALSE;
    G_Result_Status_Msg : STRING(200) := 'Idle';
    G_Result_Fail_Code : UDINT := 0;

    G_Result_Base_Priority : INT := 0;
    G_Result_Expected_Adjusted_Priority : INT := 0;
    G_Result_Actual_Adjusted_Priority : INT := 0;
    G_Result_Delta : INT := 0;

    G_Result_Budget_Exceeded : BOOL := FALSE;
    G_Result_Used_Thermal_Budget : REAL := 0.0;
    G_Result_Manifold_Enabled : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
END_VAR

VAR_GLOBAL
    I_Source_Valid : BOOL := FALSE;
    I_Last_Update_Cycle : UDINT := 0;
    I_Last_Update_MS : UDINT := 0;

    I_Arm_Request : BOOL := FALSE;
    I_Disarm_Request : BOOL := FALSE;

    I_PIN_Code : STRING(8);
    I_RFID_Tag : STRING(32);
    I_2FA_Code_In : STRING(8);

    I_Gate_Open_Request : BOOL := FALSE;
    I_Wicket_Open_Request : BOOL := FALSE;

    I_Lock_1_Open_Request : BOOL := FALSE;
    I_Lock_1_Close_Request : BOOL := FALSE;
    I_Lock_2_Open_Request : BOOL := FALSE;
    I_Lock_2_Close_Request : BOOL := FALSE;

    I_Dangerous_Action_Request : BOOL := FALSE;
    I_Dangerous_Action_Confirm : BOOL := FALSE;
    I_User_Access_Level : INT := 0;

    I_Water_Valve_Test_Open : BOOL := FALSE;
    I_Water_Valve_Test_Close : BOOL := FALSE;
    I_Water_Valve_Test_Confirm : BOOL := FALSE;

    I_Gas_Valve_Test_Open : BOOL := FALSE;
    I_Gas_Valve_Test_Close : BOOL := FALSE;
    I_Gas_Valve_Test_Confirm : BOOL := FALSE;

    I_Water_Selective_Recover : BOOL := FALSE;
    I_Gas_Selective_Recover : BOOL := FALSE;
    I_Scenario_Request : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    I_Lighting_Override_32 : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BYTE;
    I_Blinds_Override_32 : ARRAY[1..GVL_CONSTANTS.C_MAX_BLINDS] OF BYTE;
    I_Socket_Override_32 : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;
    I_Reset_Errors : BOOL := FALSE;

    I_Set_Temp_Req : BOOL := FALSE;
    I_Target_Zone : INT := 0;
    I_Target_Temperature : REAL := 0.0;
    I_Set_Vent_Req : BOOL := FALSE;
    I_Target_Vent_Speed : REAL := 0.0;
    I_Set_Config_Req : BOOL := FALSE;
    I_Time_Sync_Req : BOOL := FALSE;
    I_New_Time_MS : UDINT := 0;

    I_Set_Adapt_Profile_Req : BOOL := FALSE;
    I_Set_Adapt_Profile_Confirm : BOOL := FALSE;
    I_Adapt_Profile_Value : E_Adapt_Profile := ADAPT_PROFILE_BALANCED;
END_VAR

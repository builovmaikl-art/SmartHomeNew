{attribute 'strict'}
TYPE E_System_Reason_Code :
(
    REASON_NONE := 0,
    REASON_USER := 1,
    REASON_SAFETY := 2,
    REASON_AUTOMATION := 3,
    REASON_INTERNAL := 4,
    REASON_SCENARIO_VENT_BOOST := 5,
    REASON_USER_REQUEST := 6,
    REASON_SCENARIO_NIGHT := 7,
    REASON_DOMAIN_PROJECTION := 8
) USINT;
END_TYPE

{attribute 'pack_mode' := '1'}
TYPE ST_Calibration_Family_Summary :
STRUCT
    active : BOOL;
    status : INT; // 0=OK,1=IN_PROGRESS,2=WARNING,3=ERROR
    sensor_count : INT;
    verification_active_count : INT;
    failed_count : INT;
    max_deviation_percent : REAL;
    summary_text : STRING(160);
END_STRUCT
END_TYPE

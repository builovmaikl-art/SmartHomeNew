{attribute 'qualified_only'}
VAR_GLOBAL
    G_Inject_Enable : BOOL := FALSE;

    // Fault injection flags
    G_Inject_Gas_Level : REAL := 0.0;
    G_Inject_Force_Gas_Alarm_Reset : BOOL := FALSE;
    G_Inject_Force_IO_Offline : BOOL := FALSE;

    // Scenario runner control
    G_Scenario_Enable : BOOL := FALSE;
    G_Scenario_Auto_Run : BOOL := FALSE;
    G_Scenario_Reset_Request : BOOL := FALSE;
    G_Scenario_Current : INT := 0;
    G_Scenario_Step : INT := 0;
    G_Scenario_Done : BOOL := FALSE;
    G_Scenario_Failed : BOOL := FALSE;
    G_Scenario_Last_Result_Code : UDINT := 0;
    G_Scenario_Status_Msg : STRING(200) := 'Scenario runner idle';

    // Legacy / debug
    G_Test_Step : INT := 0;
    G_Test_Timer_MS : UDINT := 0;
END_VAR

{attribute 'qualified_only'}
VAR_GLOBAL
    // Input validation / temporal anomaly configuration.
    // Used by PRG_Input_Processing only.

    G_Enable_Reputation_Learning : BOOL := TRUE;

    G_Room_Temp_Min : REAL := -40.0;
    G_Room_Temp_Max : REAL := 80.0;
    G_Room_Hum_Min : REAL := 0.0;
    G_Room_Hum_Max : REAL := 100.0;

    G_Room_Temp_Spike_Threshold : REAL := 5.0;
    G_Room_Hum_Spike_Threshold : REAL := 20.0;

    // Confidence/reputation parameters.
    G_Reputation_Learning_Rate : REAL := 0.05;
    G_Reputation_Recovery_Decay : REAL := 0.01;
    G_Min_Sensor_Confidence : REAL := 0.1;
    G_Bad_Spike_Confidence : REAL := 0.3;
    G_Default_Confidence : REAL := 1.0;
END_VAR

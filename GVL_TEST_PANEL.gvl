{attribute 'qualified_only'}
VAR_GLOBAL
    // === CONTROL ===
    G_Enable : BOOL := FALSE;
    G_Scenario_ID : INT := 1;

    // === UI BLOCK: CURRENT TEST ===
    G_UI_00_Header : STRING(200) := '=== TEST PANEL ===';
    G_UI_01_Test : STRING(200) := 'Select G_Scenario_ID';
    G_UI_02_Change : STRING(200) := 'CHANGE: set scenario inputs';
    G_UI_03_Expected : STRING(200) := 'EXPECTED: see scenario instruction';
    G_UI_04_Result : STRING(200) := 'RESULT: Idle';
    G_UI_05_Error : STRING(200) := 'ERROR: -';
    G_UI_06_Actual : STRING(200) := 'ACTUAL: see numeric fields below';
    G_UI_07_Separator : STRING(200) := '----------------------------------------';

    // === UI BLOCK: NUMERIC FIELDS BELOW ===
    G_UI_10_Numeric_Block : STRING(200) := 'NUMERIC: Base / Expected / Actual / Delta';
    G_UI_11_Array_Block : STRING(200) := 'ARRAYS: Manifold expected / actual / enabled';
    G_UI_12_State_Block : STRING(200) := 'STATE: Safety / Block / Budget / Preheat';

    // === UX CONTROL ===
    G_Run_Counter : UDINT := 0;
    G_Last_Scenario_ID : INT := 0;
    G_Last_Result_Passed : BOOL := TRUE;
    G_Last_Fail_Code : UDINT := 0;
    G_Reset_Results_Request : BOOL := FALSE;
    G_Reset_Inputs_Request : BOOL := FALSE;
    G_Current_Test_Name : STRING(200) := '';
    G_Expected_Summary : STRING(200) := '';
    G_Actual_Summary : STRING(200) := '';
    G_Test_Result_Line : STRING(200) := 'Idle';
    G_Last_Result_Line : STRING(200) := '';
    G_Error_Text : STRING(200) := '';
    G_System_State_Line : STRING(200) := '';

    // === SCENARIO INPUTS ===
    G_Selected_Circuit : INT := 1;
    G_Input_Policy_Bias : INT := 0;
    G_Input_Guest_Preheat_Request : BOOL := FALSE;
    G_Input_Guest_Preheat_Enabled : BOOL := TRUE;
    G_Input_Guest_Preheat_Boost : INT := 2;
    G_Input_Max_Thermal_Budget : REAL := 2.0;
    G_Input_Block_Heating : BOOL := FALSE;
    G_Input_Safety_Stop : BOOL := FALSE;

    G_Input_Circuit_Enable : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF BOOL;
    G_Input_Circuit_Bias : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF INT;
    G_Input_Circuit_Guest_Preheat : ARRAY[1..GVL_CONSTANTS.C_MAX_HEATING_CIRCUITS] OF BOOL;

    G_Test_Description : STRING(200) := 'Idle';
    G_Test_What_To_Change : STRING(200) := '';
    G_Test_Expected_Text : STRING(200) := '';

    // === NUMERIC RESULT FIELDS ===
    G_Result_Mapped_Manifold : INT := 0;
    G_Result_Base_Priority : INT := 0;
    G_Result_Expected_Adjusted_Priority : INT := 0;
    G_Result_Actual_Adjusted_Priority : INT := 0;
    G_Result_Delta : INT := 0;

    G_Result_Manifold_Base_Priority : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF INT;
    G_Result_Manifold_Expected_Priority : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF INT;
    G_Result_Manifold_Actual_Priority : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF INT;
    G_Result_Manifold_Delta : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF INT;

    G_Result_Manifold_Allowed : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    G_Result_Manifold_Enabled : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    G_Result_Used_Thermal_Budget : REAL := 0.0;
    G_Result_Budget_Exceeded : BOOL := FALSE;

    G_Result_Passed : BOOL := TRUE;
    G_Result_Status_Msg : STRING(200) := 'Idle';
    G_Result_Fail_Code : UDINT := 0;
END_VAR

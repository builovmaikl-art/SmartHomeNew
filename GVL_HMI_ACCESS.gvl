    G_Status_Code : UINT;
    G_Status_Text : STRING(128);

    G_Command_Lock_1_Open : BOOL;
    G_Command_Lock_1_Close : BOOL;
    G_Command_Lock_2_Open : BOOL;
    G_Command_Lock_2_Close : BOOL;
    G_Command_Gate_Open : BOOL;
    G_Command_Wicket_Open : BOOL;

    G_Output_Lock_1_Open : BOOL;
    G_Output_Lock_1_Close : BOOL;
    G_Output_Lock_2_Open : BOOL;
    G_Output_Lock_2_Close : BOOL;
    G_Output_Gate_Open : BOOL;
    G_Output_Wicket_Open : BOOL;

    G_Physical_Lock_1_Open : BOOL;
    G_Physical_Lock_1_Close : BOOL;
    G_Physical_Lock_2_Open : BOOL;
    G_Physical_Lock_2_Close : BOOL;
    G_Physical_Gate_Open : BOOL;
    G_Physical_Wicket_Open : BOOL;

    G_Fire_Evacuation_Access_Active : BOOL;
    G_Gas_Access_Release_Active : BOOL;
    G_Safety_Cleared_Active : BOOL;
    G_Distributed_Block_Active : BOOL;
    G_Reason_Text : STRING(160);

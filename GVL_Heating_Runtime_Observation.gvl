    G_Runtime_Observation_Stabilization_Complete : BOOL := FALSE;
    G_Runtime_Observation_Operational : BOOL := FALSE;
    G_Runtime_Observation_Valid : BOOL := FALSE;
    G_Runtime_Observer_Ready : BOOL := FALSE;
    G_Runtime_Observer_Fault : BOOL := FALSE;
    G_Runtime_Observation_Status_Code : UINT := 0;
    G_Runtime_Observation_Status_Text : STRING(128) := 'Heating runtime observation inactive';

{attribute 'qualified_only'}
VAR_GLOBAL
    // Ventilation domain status. Observational only.

    G_Runtime_Required : BOOL := FALSE;
    G_Runtime_Executed : BOOL := FALSE;
    G_Runtime_Idle_By_Design : BOOL := FALSE;
    G_Runtime_Blocked_By_Command : BOOL := FALSE;
    G_Emergency_Context_Active : BOOL := FALSE;
    G_Any_Supply_Fan_Active : BOOL := FALSE;
    G_Any_Exhaust_Fan_Active : BOOL := FALSE;
    G_Vent_Enable_Active : BOOL := FALSE;
    G_Last_Update_MS : UDINT := 0;
    G_Status_Code : UINT := 0;
    G_Status_Text : STRING(128) := '';
END_VAR

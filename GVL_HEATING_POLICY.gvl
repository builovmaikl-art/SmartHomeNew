    G_Zone_Target_Adjustment : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    G_Zone_Priority_Bias : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;

    G_Policy_Mode : E_Heating_Policy_Mode := E_Heating_Policy_Mode.HPM_NORMAL;

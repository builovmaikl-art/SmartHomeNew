    G_Phase_02_Redundancy_Executed : BOOL;
    G_Phase_02_Redundancy_Valid : BOOL;
    G_Phase_02_Redundancy_Status_Text : STRING(128);

    G_Phase_03_Input_Safety_Command_Executed : BOOL;
    G_Phase_03_Input_Safety_Command_Valid : BOOL;
    G_Phase_03_Input_Safety_Command_Status_Text : STRING(128);

    G_Phase_04_Transport_Distributed_Executed : BOOL;
    G_Phase_04_Transport_Distributed_Valid : BOOL;
    G_Phase_04_Transport_Distributed_Status_Text : STRING(128);

    G_Phase_05_Domain_Output_Executed : BOOL;
    G_Phase_05_Domain_Output_Valid : BOOL;
    G_Phase_05_Domain_Output_Status_Text : STRING(128);

    G_Phase_06_PostOutput_Authority_Executed : BOOL;
    G_Phase_06_PostOutput_Authority_Valid : BOOL;
    G_Phase_06_PostOutput_Authority_Status_Text : STRING(128);

    G_Phase_07_Semantic_Governance_Executed : BOOL;

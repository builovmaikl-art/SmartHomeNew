{attribute 'qualified_only'}
VAR_GLOBAL
    // Heating domain status. Observational only.

    G_Runtime_Required : BOOL := FALSE;
    G_Runtime_Executed : BOOL := FALSE;
    G_Runtime_Idle_By_Design : BOOL := FALSE;
    G_Runtime_Blocked_By_Command : BOOL := FALSE;
    G_Emergency_Stop_Active : BOOL := FALSE;
    G_Gas_Safety_Stop_Active : BOOL := FALSE;
    G_Any_Zone_Valve_Active : BOOL := FALSE;
    G_Any_Manifold_Pump_Active : BOOL := FALSE;
    G_Any_Manifold_Valve_Active : BOOL := FALSE;
    G_DHW_Active : BOOL := FALSE;
    G_Freeze_Context_Active : BOOL := FALSE;
    G_Last_Update_MS : UDINT := 0;
    G_Status_Code : UINT := 0;
    G_Status_Text : STRING(128) := '';
END_VAR

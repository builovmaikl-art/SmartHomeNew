TYPE ST_Water_Actuator_Diagnostics_State :
STRUCT
    Runtime_Valid : BOOL;
    Runtime_System_Time_MS : UDINT;

    Valve_Group_Id : UINT;

    Travel_Active : BOOL;
    Travel_Timeout : BOOL;

{attribute 'qualified_only'}
VAR_GLOBAL
    G_Floor_Temps : ARRAY[1..8] OF REAL; // Массив текущих температур поверхности пола
    G_Room_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    G_Room_Hum : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    G_Room_CO2 : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    G_Motion_Sensors : ARRAY[1..32] OF BOOL;
    G_Door_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_DOOR_SENSORS] OF BOOL;
    G_Window_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF BOOL;
    G_Water_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_FLOOD_SENSORS] OF BOOL;
    G_Smoke_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_SMOKE_SENSORS] OF BOOL;
    G_Methane_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_METHANE_SENSORS] OF REAL;
    G_CO_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_CO_SENSORS] OF REAL;
    G_Manifold_Pressures : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF REAL;
    G_Manifold_Currents : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF REAL;
    G_Manifold_T_Supply : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF REAL;
    G_Manifold_T_Return : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF REAL;
    G_Boiler_Flame : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF BOOL;
    G_Boiler_Error : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF BOOL;
    G_Boiler_OT_Online : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF BOOL; // Статус доступности OpenTherm-канала котла от реального OT-адаптера/драйвера
    G_Boiler_OT_Enable : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF BOOL; // Команды разрешения через OpenTherm
    G_Boiler_OT_Setpoint : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF REAL; // Уставки через OpenTherm
    G_Physical_Switches : ARRAY[1..32] OF BOOL;
    G_Socket_Switches : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL; // Legacy-поле: локальные выключатели розеток не используются
    G_Outdoor_Temp : REAL;
    G_Supply_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_SUPPLY_TEMPS] OF REAL; // Температура приточного воздуха после калорифера
    G_DHW_Temp : REAL;
    G_DHW_Pressure : REAL;
    G_Zone_Valves : ARRAY[1..8] OF BOOL;
    G_Manifold_Pumps : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    G_Manifold_Valves : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF REAL; // 0.0 - 1.0
    G_Manifold_End_Switches : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL; // Концевики клапанов
    G_Supply_Fans : ARRAY[1..GVL_CONSTANTS.C_MAX_SUPPLY_FANS] OF REAL; // 0.0 - 1.0
    G_Exhaust_Fans : ARRAY[1..GVL_CONSTANTS.C_MAX_EXHAUST_FANS] OF REAL; // 0.0 - 1.0
    G_Vent_Heater_Power : ARRAY[1..GVL_CONSTANTS.C_MAX_BOILERS] OF REAL;
    G_Lighting_Levels : ARRAY[1..32] OF BYTE;
    G_Blinds_Positions : ARRAY[1..GVL_CONSTANTS.C_MAX_BLINDS] OF BYTE;
    G_Socket_States : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;
    G_DHW_Heating_Pump : BOOL;
    G_DHW_Circ_Pump : BOOL;
    G_Backup_Circulation_Pump : BOOL; // Резервный циркуляционный насос для антизамерзания при газовой аварии
    G_Electric_Heater_Enable : BOOL; // Сухой контакт электрического нагревателя для антизамерзания
    G_Safety_Gas_Alarm : BOOL;
    G_Safety_Leak_Alarm : BOOL;
    G_Safety_Smoke_Alarm : BOOL;
    G_Safety_Emergency_Stop : BOOL; // агрегированный аварийный стоп
    G_Safety_Gas_Latched : BOOL; // защёлкнутая газовая авария
    G_Safety_Leak_Latched : BOOL; // защёлкнутая авария протечки
    G_Safety_Smoke_Latched : BOOL; // защёлкнутая дымовая/пожарная авария
    G_Safety_Freeze_Risk : BOOL; // риск замерзания при защёлкнутой газовой аварии
    G_System_Mode : E_System_Operating_Mode := E_System_Operating_Mode.MODE_NORMAL; // Текущий режим работы системы
    G_System_Mode_Text : STRING(64);
    G_Heating_IO_Fault : BOOL;
    G_Heating_Sensor_Fault : BOOL;
    G_Heating_Subsystem_Degraded : BOOL;
    G_DHW_IO_Fault : BOOL;
    G_DHW_Sensor_Fault : BOOL;
    G_DHW_Subsystem_Degraded : BOOL;
    G_Ventilation_IO_Fault : BOOL;
    G_Ventilation_Subsystem_Degraded : BOOL;
    G_Lighting_IO_Fault : BOOL;
    G_Lighting_Subsystem_Degraded : BOOL;
    G_Access_Comm_Fault : BOOL;
    G_Evacuation_Lighting_Active : BOOL;
    G_Evac_Hazard_Zone : ARRAY[1..32] OF BOOL; // опасные зоны (дым/протечка)
    G_Evac_Guidance : ARRAY[1..32] OF INT; // -1 = избегать, 0 = нейтрально, +1 = к выходу
 // Активен режим световой эвакуации // Текстовый статус режима работы системы

    G_Rule_Actions : ARRAY[1..GVL_CONSTANTS.C_MAX_RULES] OF ST_Rule_Action;
    G_Sim_Lights : ARRAY[1..32] OF BOOL;
    G_Freeze_Hardware_Degraded : BOOL; // Деградация anti-freeze hardware
    G_Freeze_Hardware_Failed : BOOL; // Критический отказ anti-freeze hardware
    G_Water_Zone_Enable : ARRAY[1..32] OF BOOL; // Селективное открытие воды по зонам
    G_Water_Zone_Open_FB : ARRAY[1..32] OF BOOL; // Обратная связь: зональный клапан открыт
    G_Water_Zone_Close_FB : ARRAY[1..32] OF BOOL; // Обратная связь: зональный клапан закрыт
    G_Water_Zone_Exercise_Active : ARRAY[1..32] OF BOOL; // Профилактическая прокрутка шаровых кранов
    G_Preheat_Request : BOOL; // Heating request: preheat
    G_Freeze_Request : BOOL; // Heating request: freeze
    G_Target_Temperature : REAL; // Heating arbitration target
END_VAR
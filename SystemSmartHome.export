      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">56</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 1. Мониторинг датчиков</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">57</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Sensor_Open := VI_Group_2F_Open;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">58</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 15 DO IF VI_Opening_Sensors[L_i] THEN L_Any_Sensor_Open := TRUE; EXIT; END_IF; END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">59</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">60</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Glass_Broken := VI_Group_2F_Glass;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">61</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 15 DO IF VI_GlassBreak_Sensors[L_i] THEN L_Any_Glass_Broken := TRUE; EXIT; END_IF; END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">62</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">63</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// ТЗ 3.3: Подсчет срабатываний за 10с</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">64</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Trigger_Timer(IN := L_Trigger_Count &gt; 0, PT := T#10s);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">65</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF L_Trigger_Timer.Q THEN L_Trigger_Count := 0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">66</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">67</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 15 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">68</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Opening_Sensors[L_i] AND NOT L_Last_Sensors[L_i] THEN L_Trigger_Count := L_Trigger_Count + 1; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">69</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Last_Sensors[L_i] := VI_Opening_Sensors[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">70</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">71</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_GlassBreak_Sensors[L_i] AND NOT L_Last_Sensors[15 + L_i] THEN L_Trigger_Count := L_Trigger_Count + 1; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">72</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Last_Sensors[15 + L_i] := VI_GlassBreak_Sensors[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">73</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">74</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Групповые датчики тоже участвуют в подсчете</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">75</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_Group_2F_Open AND NOT L_Last_Sensors[31] THEN L_Trigger_Count := L_Trigger_Count + 1; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">76</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Last_Sensors[31] := VI_Group_2F_Open;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">77</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_Group_2F_Glass AND NOT L_Last_Sensors[32] THEN L_Trigger_Count := L_Trigger_Count + 1; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">78</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Last_Sensors[32] := VI_Group_2F_Glass;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">79</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">80</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// ТЗ 3.8: Снижение порога на 20% (увеличиваем чувствительность)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">81</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Glass_Threshold_Multiplier := SEL(VI_Acknowledge_Open_Windows, 1.0, 0.8);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">82</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">83</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 2. Логика состояний</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">84</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">CASE L_State OF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">85</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    0: // Снято с охраны</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">86</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Armed := FALSE; VO_Alarm_Active := FALSE; VO_Entry_Delay_Active := FALSE; VO_Long_Away_Req := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">87</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF VI_PIN_Submit AND VI_PIN_Input = VI_Config.PIN_Code THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">88</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            IF NOT L_Any_Sensor_Open OR VI_Acknowledge_Open_Windows THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">89</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                IF VI_Config.Two_Stage_Mode THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">90</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                    L_State := 4; L_Confirm_Start_Time := VI_System_Time_MS;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">91</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                    VO_Status_Msg := 'Ожидание второго этапа подтверждения';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">92</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">93</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                    L_State := 1; L_Away_Start_Time := VI_System_Time_MS; L_Attempts := 0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">94</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                    VO_Status_Msg := 'Система поставлена на охрану';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">95</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">96</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">97</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                VO_Status_Msg := 'Ошибка: Обнаружены открытые окна/двери';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">98</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">99</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">100</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">101</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    4: // Ожидание второго этапа (ТЗ 3.4)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">102</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF (VI_System_Time_MS - L_Confirm_Start_Time) / 1000 &gt;= VI_Config.Confirmation_Timeout_S THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">103</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            L_State := 0; VO_Status_Msg := 'Таймаут подтверждения постановки';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">104</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        ELSIF VI_PIN_Submit AND VI_PIN_Input = VI_Config.PIN_Code THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">105</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">             L_State := 1; L_Away_Start_Time := VI_System_Time_MS; L_Attempts := 0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">106</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">             VO_Status_Msg := 'Система поставлена на охрану (2 этапа)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">107</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">108</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">109</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    1: // На охране</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">110</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Armed := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">111</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        // ТЗ 3.3: Немедленная тревога если &gt;=2 датчика за 10с</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">112</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF L_Trigger_Count &gt;= 2 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">113</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            L_State := 3;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">114</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        ELSIF L_Any_Sensor_Open OR L_Any_Glass_Broken THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">115</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            L_State := 2; L_Entry_Start_Time := VI_System_Time_MS;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">116</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">117</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">118</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    2: // Задержка входа (ТЗ 3.3)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">119</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Entry_Delay_Active := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">120</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Time_To_Alarm_S := TO_UINT(VI_Config.Entry_Delay_S - (VI_System_Time_MS - L_Entry_Start_Time) / 1000);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">121</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF VI_PIN_Submit THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">122</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            IF VI_PIN_Input = VI_Config.PIN_Code THEN L_State := 0; VO_Status_Msg := 'Система снята с охраны';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">123</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">124</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                L_Attempts := L_Attempts + 1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">125</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                IF L_Attempts &gt;= VI_Config.Max_Attempts THEN L_State := 3; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">126</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">127</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">128</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF (VI_System_Time_MS - L_Entry_Start_Time) / 1000 &gt;= VI_Config.Entry_Delay_S THEN L_State := 3; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">129</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">130</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    3: // Тревога</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">131</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Alarm_Active := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">132</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Long_Away_Req := TRUE; // ТЗ 3.6: При тревоге -&gt; долгосрочный отъезд</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">133</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Status_Msg := 'ТРЕВОГА: НАРУШЕНИЕ ПЕРИМЕТРА';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">134</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF VI_PIN_Submit AND VI_PIN_Input = VI_Config.PIN_Code THEN L_State := 0; VO_Status_Msg := 'Тревога сброшена'; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">135</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_CASE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">136</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">137</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 3. Уровни отъезда (ТЗ 3.5)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">138</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF L_State &lt;&gt; 0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">139</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Last_Trigger_Time := (VI_System_Time_MS - L_Away_Start_Time) / 3600000; // Часы</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">140</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Last_Trigger_Time &lt; 2 THEN VO_Away_Level := 1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">141</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    ELSIF L_Last_Trigger_Time &lt; 72 THEN VO_Away_Level := 2;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">142</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    ELSE VO_Away_Level := 3; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">143</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE VO_Away_Level := 0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">144</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">145</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 4. Интеграция с освещением (ТЗ 3.9)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">146</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF (VI_Outdoor_Lux &lt; 50.0 OR (TOD_TO_UDINT(UDINT_TO_TOD(VI_System_Time_MS)) &gt; 64800000 OR TOD_TO_UDINT(UDINT_TO_TOD(VI_System_Time_MS)) &lt; 28800000)) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">147</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Motion_Corridor OR (L_State = 2) THEN VO_Light_Corridor := TRUE; VO_Light_Stairs_Dim := 30;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">148</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    ELSE VO_Light_Corridor := FALSE; VO_Light_Stairs_Dim := 0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">149</Single>
                <Null Name="Tag" />

                <Null Name="Tag" />
                <Single Name="Text" Type="string">    0: // ОЖИДАНИЕ (IDLE)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1663</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF L_cmd_rising THEN</Single>
              </Single>

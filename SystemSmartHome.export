            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">430</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 1. Определение режима</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">431</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Current_Time := UDINT_TO_TOD(VI_System_Time_MS MOD 86400000);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">432</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Is_Night := (L_Current_Time &gt;= VI_Config.Night_Mode_Start OR L_Current_Time &lt;= VI_Config.Night_Mode_End);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">433</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">434</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Поиск максимумов</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">435</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Max_CO2 := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">436</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 8 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">437</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_CO2[L_i] &gt; L_Max_CO2 THEN L_Max_CO2 := VI_CO2[L_i]; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">438</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">439</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">440</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Max_Hum := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">441</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 8 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">442</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Humidity[L_i] &gt; L_Max_Hum THEN L_Max_Hum := VI_Humidity[L_i]; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">443</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">444</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">445</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Выбор режима (ТЗ 6.3)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">446</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_Gas_Alarm OR VI_Fire_Alarm OR VI_Flood_Alarm THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">447</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Mode := 3; // Аварийный</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">448</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Base_Speed := 100.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">449</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_Max_CO2 &gt; VI_Config.CO2_Threshold OR L_Max_Hum &gt; VI_Config.Humidity_Threshold THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">450</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Mode := 2; // Интенсив</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">451</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Base_Speed := 70.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">452</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_Is_Night THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">453</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Mode := 0; // Эконом</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">454</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Base_Speed := 20.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">455</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">456</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Mode := 1; // Стандарт</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">457</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Base_Speed := 40.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">458</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">459</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">460</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 2. Управление вентиляторами</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">461</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 3 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">462</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Supply_Fans[L_i] := L_Base_Speed;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">463</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">464</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 5.4: CO -&gt; приток 80%</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">465</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Supply_80_Req THEN VO_Supply_Fans[L_i] := 80.0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">466</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">467</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 6.4: Метан &gt;20% -&gt; приток 100%</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">468</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Supply_100_Req THEN VO_Supply_Fans[L_i] := 100.0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">469</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">470</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 5.1: ПВ-3 форсирован при 10% LEL</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">471</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_i = 3 AND VI_PV3_Boost THEN VO_Supply_Fans[L_i] := 100.0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">472</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">473</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Интеграция с безопасностью (ТЗ 6.4): При пожаре приток ОТКЛЮЧАЕТСЯ</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">474</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Fire_Alarm THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">475</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Supply_Fans[L_i] := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">476</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">477</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">478</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">479</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 5 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">480</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Exhaust_Fans[L_i] := L_Base_Speed;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">481</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">482</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 4.0: Интеграция с мокрыми зонами (вытяжки 4-5)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">483</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_i &gt;= 4 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">484</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        L_Wet_Zone_Timers[L_i-3](IN := VI_Wet_Zone_Lights[L_i-3], PT := T#7m); // 7 мин пост-вентиляция</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">485</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF L_Wet_Zone_Timers[L_i-3].Q THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">486</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            VO_Exhaust_Fans[L_i] := MAX(VO_Exhaust_Fans[L_i], 60.0); // Форсируем вытяжку</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">487</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">488</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">489</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">490</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 6.4: Пожар -&gt; вытяжка 100%</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">491</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Exhaust_100_Req THEN VO_Exhaust_Fans[L_i] := 100.0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">492</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">493</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">494</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 3. Статус</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">495</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 3 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">496</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Enabled := VI_IsActivePLC;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">497</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Speed_Percent := VO_Supply_Fans[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">498</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Mode := L_Mode;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">499</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
            </Array>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">500</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FUNCTION_BLOCK FB_Ventilation_System_Manager</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">501</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR_INPUT</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">502</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_System_Time_MS : UDINT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">503</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_IsActivePLC : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">504</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_CO2 : ARRAY[1..8] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">505</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Humidity : ARRAY[1..8] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">506</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Gas_Alarm : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">507</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Fire_Alarm : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">508</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Flood_Alarm : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">509</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Config : ST_Ventilation_Config;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">510</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_PV3_Boost : BOOL; // ТЗ 5.1</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">511</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Supply_100_Req : BOOL; // ТЗ 6.4</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">512</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Exhaust_100_Req : BOOL; // ТЗ 6.4</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">513</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Supply_80_Req : BOOL; // ТЗ 5.4</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">514</Single>
                <Null Name="Tag" />

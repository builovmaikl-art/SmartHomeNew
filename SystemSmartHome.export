                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 3. Генерация предупреждения</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">48</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VIO_Health_Data.Health_Score &lt; 20 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">49</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VIO_Health_Data.Maintenance_Required := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">50</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VIO_Health_Data.Warning_Message := 'Критический износ: проверьте механику';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">

                <Single Name="Text" Type="string">       (VI_Local_PLC_ID = 2 AND (L_i MOD 2 &lt;&gt; 0)) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">26</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Assigned_Sensors[L_i] := VI_Raw_Sensors[L_i];</Single>
              </Single>

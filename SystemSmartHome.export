              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">261</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">262</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">263</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // 80-82: Розетки (битовая маска, 36 розеток -&gt; 3 WORD)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">264</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    FOR L_i := 0 TO 2 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">265</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        L_tmp_word := 0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">266</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        FOR L_j := 1 TO 16 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">267</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            L_idx := (L_i * 16) + L_j;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">268</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            IF L_idx &lt;= 36 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">269</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                IF VI_Socket_States[L_idx] THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">270</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                    L_tmp_word := L_tmp_word OR SHL(TO_WORD(1), L_j - 1);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">271</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">272</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">273</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">274</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Modbus_Registers[79 + L_i] := L_tmp_word;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">275</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">276</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">277</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Data_Ready := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">278</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">279</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">280</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Обработка входящих команд</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">281</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_Command_Received AND (VI_Local_PLC_Role = E_PLC_ROLE.ROLE_ACTIVE) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">282</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    CASE VI_Incoming_Command.command_type OF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">283</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        1: // Управление сценариями</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">284</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            GVL_Vars.G_Current_Scenario := VI_Incoming_Command.target_scenario;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">285</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            VO_HMI_Status_Message := 'Gateway: Сценарий изменен';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">286</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        2: // Управление освещением</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">287</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            IF (VI_Incoming_Command.target_zone &gt;= 1) AND (VI_Incoming_Command.target_zone &lt;= 16) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">288</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                VO_Lighting_Override[VI_Incoming_Command.target_zone] := TO_BYTE(VI_Incoming_Command.target_value);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">289</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                VO_HMI_Status_Message := 'Gateway: Команда освещения принята';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">290</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">291</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        3: // Розетки</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">292</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            IF (VI_Incoming_Command.target_zone &gt;= 1) AND (VI_Incoming_Command.target_zone &lt;= 36) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">293</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">                VO_Socket_Override[VI_Incoming_Command.target_zone] := VI_Incoming_Command.target_on_off;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">294</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">295</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        4: // Охрана</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">296</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            // Логика постановки/снятия через PIN в FB_Security_System_Manager</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">297</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            // Здесь можно только передать запрос</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">298</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            VO_HMI_Status_Message := 'Gateway: Запрос охраны принят';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">299</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_CASE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">300</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
            </Array>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">301</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FUNCTION_BLOCK FB_Gateway_Interface</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">302</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR_INPUT</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">

                <Single Name="Text" Type="string">IF VO_Flood_Alarm AND NOT L_Emergency_Timer.IN AND NOT L_Confirm_Wait THEN VO_Status_Msg := 'ОБНАРУЖЕНА ПРОТЕЧКА ВОДЫ'; END_IF;</Single>

              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">306</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Command_Received         : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">307</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">308</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Состояния системы</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">309</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_FloorHeating_Temps       : ARRAY[1..16] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">310</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Room_Temps               : ARRAY[1..16] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">311</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Zone_Valve_States        : ARRAY[1..16] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">312</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Pressures       : ARRAY[1..5] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">313</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Pump_States     : ARRAY[1..5] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">314</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Outdoor_Temp             : REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">315</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Security_Armed           : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">316</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Flood_Alarm_Active       : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">317</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Gas_Alarm_Active         : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">318</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Fire_Alarm_Active        : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">319</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Methane_Concentration    : REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">320</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Lighting_Base_Levels     : ARRAY[1..16] OF BYTE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">321</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Socket_States            : ARRAY[1..36] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">322</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Blinds_Positions         : ARRAY[1..20] OF BYTE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">323</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Active_Scenario          : E_SCENARIO_TYPE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">324</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">325</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">326</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR_OUTPUT</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">327</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Modbus_Registers         : ARRAY[0..200] OF WORD; // Расширенный диапазон</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">328</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Lighting_Override        : ARRAY[1..16] OF BYTE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">329</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Socket_Override          : ARRAY[1..36] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">330</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Data_Ready               : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">331</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_HMI_Status_Message       : STRING(200);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">332</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">333</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">334</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">335</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_last_update_time          : UDINT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">336</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_i                         : INT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">337</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_j                         : INT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">338</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_idx                       : INT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">339</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_tmp_word                  : WORD;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_VAR</Single>
              </Single>
            </Array>

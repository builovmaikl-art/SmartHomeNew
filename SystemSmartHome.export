      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">805688e0-2367-4f59-8cd8-199d9cef1817</Single>
        <Single Name="ParentGuid" Type="System.Guid">00000000-0000-0000-0000-000000000000</Single>
        <Single Name="Name" Type="string">FB_Heating_System_Manager</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">21af5390-2942-461a-bf89-951aaf6999f1</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">a777e318-0889-4538-8b2a-ae0890b04611</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639081395208634337</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">252</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 1. Расчет целевой температуры подачи (ТЗ 2.3)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">253</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Target_Supply_Temp := 35.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">254</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_Config.Weather_Comp_Enabled AND VI_Outdoor_Temp &lt; 15.0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">255</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Исправлено: убран множитель 10.0 согласно ТЗ 2.3</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">256</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Target_Supply_Temp := L_Target_Supply_Temp + (15.0 - VI_Outdoor_Temp) * VI_Config.Weather_Coef;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">257</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">258</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Target_Supply_Temp := LIMIT(20.0, L_Target_Supply_Temp, 45.0);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">259</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">260</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 2. Управление зонами (ТЗ 1.1, 2.5)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">261</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 16 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">262</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Overheat_Timer[L_i](IN := VI_Floor_Temps[L_i] &gt; VI_Config.Overheat_Threshold, PT := T#60s);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">263</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">264</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Room_Temps[L_i] &lt; (VI_Config.Target_Room_Temp - VI_Config.Hysteresis) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">265</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Zone_Valves[L_i] := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">266</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    ELSIF VI_Room_Temps[L_i] &gt; (VI_Config.Target_Room_Temp + VI_Config.Hysteresis) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">267</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Zone_Valves[L_i] := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">268</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">269</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">270</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Защита от перегрева с задержкой 60с (ТЗ 2.5)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">271</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Overheat_Timer[L_i].Q THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">272</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Zone_Valves[L_i] := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">273</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">274</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">275</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">276</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 3. Активность коллекторов</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">277</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Zone_Active[1] := VO_Zone_Valves[1] OR VO_Zone_Valves[2];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">278</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Zone_Active[2] := VO_Zone_Valves[3] OR VO_Zone_Valves[4] OR VO_Zone_Valves[5] OR VO_Zone_Valves[6];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">279</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Zone_Active[3] := VO_Zone_Valves[7] OR VO_Zone_Valves[8] OR VO_Zone_Valves[9];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">280</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Zone_Active[4] := VO_Zone_Valves[10] OR VO_Zone_Valves[11] OR VO_Zone_Valves[12];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">281</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Any_Zone_Active[5] := VO_Zone_Valves[13] OR VO_Zone_Valves[14] OR VO_Zone_Valves[15] OR VO_Zone_Valves[16];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">282</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">283</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 4. Управление коллекторами (ТЗ 2.6, 12.2)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">284</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 5 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">285</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_PID_Valves[L_i](</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">286</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VI_SetPoint := L_Target_Supply_Temp,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">287</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VI_ProcessValue := VI_Manifold_Temps_Supply[L_i],</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">288</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VI_Kp := 2.0, VI_Tn := 120.0, VI_Tv := 0.0,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">289</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VI_Y_Min := 0.0, VI_Y_Max := 100.0, VI_Cycle_Time_S := 1.0,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">290</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Output =&gt; VO_Manifold_Valves[L_i]</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">291</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    );</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">292</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">293</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 2.6: Пауза после 72 часов работы</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">294</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Pump_Run_Timer[L_i](IN := VO_Manifold_Pumps[L_i] AND NOT L_Pump_In_Pause[L_i], PT := T#72h);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">295</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Pump_Run_Timer[L_i].Q THEN L_Pump_In_Pause[L_i] := TRUE; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">296</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">297</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Pump_Pause_Timer[L_i](IN := L_Pump_In_Pause[L_i], PT := T#1h);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">298</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Pump_Pause_Timer[L_i].Q THEN L_Pump_In_Pause[L_i] := FALSE; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">299</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">300</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Manifold_Pumps[L_i] := VI_IsActivePLC AND L_Any_Zone_Active[L_i] AND NOT L_Pump_In_Pause[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">301</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">302</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Защита от замерзания (ТЗ 2.4)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">303</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Outdoor_Temp &lt; -5.0 OR VI_Manifold_Temps_Supply[L_i] &lt; VI_Config.Freeze_Threshold THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">304</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Manifold_Pumps[L_i] := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">305</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Manifold_Valves[L_i] := 100.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">306</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">307</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">308</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Диагностика (ТЗ 2.6)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">309</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Pump_On := VO_Manifold_Pumps[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">310</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Pump_Current := VI_Manifold_Currents[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">311</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Pressure := VI_Manifold_Pressures[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">312</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Temp_Supply := VI_Manifold_Temps_Supply[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">313</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Temp_Return := VI_Manifold_Temps_Return[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">314</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status[L_i].Valve_Pos := VO_Manifold_Valves[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">315</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">316</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Контроль давления (1.5-2.5 бар) и Delta T (5-10C)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">317</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VO_Manifold_Pumps[L_i] THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">318</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF VI_Manifold_Pressures[L_i] &lt; 1.5 OR VI_Manifold_Pressures[L_i] &gt; 2.5 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">319</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            VO_Status[L_i].Error := TRUE; VO_Status[L_i].Error_ID := 16#E004; // Pressure Out of Range</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">320</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">321</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        // Исправлено: порог Delta T снижен до 10.0 согласно ТЗ 2.6</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">322</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF (VI_Manifold_Temps_Supply[L_i] - VI_Manifold_Temps_Return[L_i]) &gt; 10.0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">323</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">            VO_Status[L_i].Error := TRUE; VO_Status[L_i].Error_ID := 16#E005; // High Delta T</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">324</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">325</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">326</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">327</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Тестирование арматуры (ТЗ 12.2)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">328</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF (VI_System_Time_MS MOD 604800000) &lt; 10000 THEN VO_Manifold_Valves[L_i] := 20.0; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">329</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">330</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">331</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 5. Каскад котлов (ТЗ 2.8, 12.3)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">332</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Demand_Power := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">333</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 5 DO IF VO_Manifold_Pumps[L_i] THEN L_Demand_Power := L_Demand_Power + VO_Manifold_Valves[L_i]; END_IF; END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">334</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Demand_Power := L_Demand_Power / 5.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">335</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">336</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF (VI_System_Time_MS - L_Last_Boiler_Rotation) &gt; 604800000 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">337</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Last_Boiler_Rotation := VI_System_Time_MS;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">338</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Lead_Boiler := SEL(L_Lead_Boiler = 1, 1, 2);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">339</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">340</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">341</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VI_IsActivePLC AND L_Demand_Power &gt; 5.0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">342</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Enable[L_Lead_Boiler] := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">343</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Setpoint[L_Lead_Boiler] := L_Target_Supply_Temp + 5.0; // OpenTherm Setpoint</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">344</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Enable[3 - L_Lead_Boiler] := (L_Demand_Power &gt; 80.0);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">345</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Setpoint[3 - L_Lead_Boiler] := SEL(L_Demand_Power &gt; 80.0, 0.0, L_Target_Supply_Temp + 5.0);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">346</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">347</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Enable[1] := FALSE; VO_Boiler_Enable[2] := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">348</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">349</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">350</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Учет наработки (ТЗ 2.8, 12.3)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">351</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 2 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">352</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Boiler_Flame_Status[L_i] THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">353</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Boiler_Status[L_i].Work_Seconds := VO_Boiler_Status[L_i].Work_Seconds + 1; // Assuming 1s cycle for this FB or call</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">354</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Boiler_Status[L_i].Work_Hours := TO_REAL(VO_Boiler_Status[L_i].Work_Seconds) / 3600.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">355</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        VO_Boiler_Status[L_i].Resource_Percent := (1.0 - (TO_REAL(VO_Boiler_Status[L_i].Work_Seconds) / L_Lifespan_S)) * 100.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">356</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">357</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Status[L_i].Running := VI_Boiler_Flame_Status[L_i];</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">358</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
            </Array>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">359</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FUNCTION_BLOCK FB_Heating_System_Manager</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">360</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR_INPUT</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">361</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Maintenance_Zones : ARRAY[1..16] OF ST_Component_Maintenance;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">362</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Maintenance_Manifolds : ARRAY[1..5] OF ST_Component_Maintenance;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">363</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_System_Time_MS : UDINT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">364</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_IsActivePLC : BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">365</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Outdoor_Temp : REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">366</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Floor_Temps : ARRAY[1..16] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">367</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Room_Temps : ARRAY[1..16] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">368</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Config : ST_Heating_Config;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">369</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Pressures : ARRAY[1..5] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">370</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Currents : ARRAY[1..5] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">371</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Temps_Supply : ARRAY[1..5] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">372</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Manifold_Temps_Return : ARRAY[1..5] OF REAL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">373</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VI_Boiler_Flame_Status : ARRAY[1..2] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">374</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">375</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR_OUTPUT</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">376</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Manifold_Valves : ARRAY[1..5] OF REAL; // 0-100%</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">377</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Manifold_Pumps : ARRAY[1..5] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">378</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Zone_Valves : ARRAY[1..16] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">379</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Enable : ARRAY[1..2] OF BOOL;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">380</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Setpoint : ARRAY[1..2] OF REAL; // OpenTherm Setpoint</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">381</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status : ARRAY[1..5] OF ST_Manifold_Status;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">382</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Boiler_Status : ARRAY[1..2] OF ST_Boiler_Status;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">383</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">384</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VAR</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">385</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_PID_Valves : ARRAY[1..5] OF FB_PID_Controller;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">386</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Last_Boiler_Rotation : UDINT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">387</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Lead_Boiler : BYTE := 1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">388</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_i : INT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">

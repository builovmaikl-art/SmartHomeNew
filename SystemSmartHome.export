      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">280</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 1. Обработка метана (ТЗ 5.1, 6.4)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">281</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Methane_Max := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">282</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 2 DO IF VI_Methane_LEL[L_i] &gt; L_Methane_Max THEN L_Methane_Max := VI_Methane_LEL[L_i]; END_IF; END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">283</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">284</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">VO_Vent_PV3_Boost := (L_Methane_Max &gt;= 10.0); // ТЗ 5.1: ПВ-3 при 10% LEL</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">285</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">286</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF L_Methane_Max &gt;= 40.0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">287</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Gas_Alarm := TRUE; VO_Gas_Valve_Close := TRUE; VO_Boiler_Stop := TRUE; VO_Supply_100_Req := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">288</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status_Msg := 'КРИТИЧЕСКАЯ УТЕЧКА ГАЗА (40% LEL)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">289</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_Methane_Max &gt;= 20.0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">290</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Gas_Alarm := TRUE; VO_Gas_Valve_Close := TRUE; VO_Boiler_Stop := TRUE; VO_Supply_100_Req := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">291</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status_Msg := 'УТЕЧКА ГАЗА (20% LEL)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">292</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_Methane_Max &gt;= 10.0 THEN </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">293</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status_Msg := 'ПРЕДУПРЕЖДЕНИЕ: ГАЗ (10% LEL)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">294</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">295</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">296</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 2. Обработка CO (ТЗ 5.2, 5.4)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">297</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_CO_Max := 0.0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">298</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 8 DO IF VI_CO_PPM[L_i] &gt; L_CO_Max THEN L_CO_Max := VI_CO_PPM[L_i]; END_IF; END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">299</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">300</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_CO_Timer_30ppm(IN := (L_CO_Max &gt;= 30.0), PT := T#8h);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">301</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_CO_Timer_70ppm(IN := (L_CO_Max &gt;= 70.0), PT := T#1h);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">302</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_CO_Timer_400ppm(IN := (L_CO_Max &gt;= 400.0), PT := T#15m);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">303</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">304</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF L_CO_Timer_400ppm.Q THEN VO_Gas_Alarm := TRUE; VO_Status_Msg := 'КРИТИЧЕСКАЯ КОНЦЕНТРАЦИЯ CO (400 ppm / 15 мин)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">305</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_CO_Timer_70ppm.Q THEN VO_Gas_Alarm := TRUE; VO_Status_Msg := 'ВЫСОКАЯ КОНЦЕНТРАЦИЯ CO (70 ppm / 1 час)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">306</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF L_CO_Timer_30ppm.Q THEN VO_Gas_Alarm := TRUE; VO_Status_Msg := 'ПОВЫШЕННАЯ КОНЦЕНТРАЦИЯ CO (30 ppm / 8 час)';</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">307</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">308</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">309</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VO_Gas_Alarm AND L_CO_Max &gt;= 30.0 THEN VO_Supply_80_Req := TRUE; END_IF; // ТЗ 5.4</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">310</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">311</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 3. Обработка дыма (ТЗ 5.3, 6.4)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">312</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">L_Smoke_Count := 0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">313</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">FOR L_i := 1 TO 6 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">314</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Smoke_Timer[L_i](IN := VI_Smoke_Sensors[L_i], PT := T#30s);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">315</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Smoke_Sensors[L_i] THEN L_Smoke_Count := L_Smoke_Count + 1; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">316</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // ТЗ 5.3: Верификация вторым датчиком ИЛИ сигнал &gt; 30 сек</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">317</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Smoke_Timer[L_i].Q OR (L_Smoke_Count &gt;= 2) THEN L_Smoke_Active := TRUE; END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">318</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_FOR;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">319</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">320</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF L_Smoke_Active THEN </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">321</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Fire_Alarm := TRUE; VO_Boiler_Stop := TRUE; VO_Exhaust_100_Req := TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">322</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Status_Msg := 'ПОЖАРНАЯ ТРЕВОГА: ДЫМ'; </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">323</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">324</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">325</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// 4. Сирена и квитирование (ТЗ 5.5)</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">326</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF VO_Gas_Alarm OR VO_Fire_Alarm THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">327</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF VI_Mute_Request AND NOT L_Muted AND L_Mute_Count &lt; 3 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">328</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        L_Muted := TRUE; L_Mute_Count := L_Mute_Count + 1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">329</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        L_Mute_Timer(IN := TRUE, PT := T#5m);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">330</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">331</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">332</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Mute_Timer(IN := L_Muted);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">333</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF L_Mute_Timer.Q THEN L_Muted := FALSE; L_Mute_Timer(IN := FALSE); END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">334</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    VO_Siren_Active := NOT L_Muted;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">335</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">336</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    L_Muted := FALSE; L_Mute_Count := 0; VO_Siren_Active := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">337</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
            </Array>
          </Single>
        </Single>

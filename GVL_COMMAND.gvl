{attribute 'qualified_only'}
VAR_GLOBAL
    // ======================================================
    // LEGACY / OPERATOR COMMAND REQUEST SURFACE
    // ======================================================
    // This GVL is retained as legacy/operator command request
    // surface and comparison source for command verification.
    //
    // Runtime operational command ownership lives in
    // GVL_COMMAND_SHADOW and is published by PRG_Command_Arbitration.
    //
    // PreOutput and Command_Verifier may compare this surface against
    // GVL_COMMAND_SHADOW, but must not treat GVL_COMMAND as final
    // physical output authority.
    // ======================================================

    G_Gas_Valve_Close : BOOL := FALSE;
    G_Boiler_Stop : BOOL := FALSE;
    G_Supply_100_Req : BOOL := FALSE;
    G_Supply_80_Req : BOOL := FALSE;
    G_Vent_PV3_Boost : BOOL := FALSE;
    G_Exhaust_100_Req : BOOL := FALSE;
    G_Vent_Stop : BOOL := FALSE;
    G_Close_Valve_35 : BOOL := FALSE;
    G_Close_Valve_36 : BOOL := FALSE;
    G_Gate_Open : BOOL;
    G_Wicket_Open : BOOL;
    G_Lock_1_Open : BOOL;
    G_Lock_1_Close : BOOL;
    G_Lock_2_Open : BOOL;
    G_Lock_2_Close : BOOL;
    G_Reset_Errors : BOOL := FALSE;
    G_Scenario_Request : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;
    G_Scenario_Request_Operator : E_SCENARIO_TYPE := E_SCENARIO_TYPE.SCENARIO_NONE;

    G_Arm_Req : BOOL;
    G_Disarm_Req : BOOL;
    G_PIN_Code : STRING(4);
    G_RFID_Tag : STRING(20);
    G_2FA_Code_In : STRING(6);
    G_Send_2FA_Req : BOOL;
    G_2FA_Code_Out : STRING(6);
    G_Lighting_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_LIGHT_ZONES] OF BYTE;
    G_Blinds_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_BLINDS] OF BYTE;
    G_Socket_Override : ARRAY[1..GVL_CONSTANTS.C_MAX_SOCKETS] OF BOOL;
    CMD_Set_Manifold_Pump_In_Service : ARRAY[1..GVL_CONSTANTS.C_MAX_MANIFOLDS] OF BOOL;
    CMD_Set_DHW_Heating_Pump_In_Service : BOOL;
    CMD_Set_DHW_Circ_Pump_In_Service : BOOL;
    CMD_Dangerous_Action_Confirm : BOOL;
    CMD_Dangerous_Action_Request : BOOL;
    CMD_User_Access_Level : INT := 0;
    CMD_Valve_Test_Open : BOOL;
    CMD_Valve_Test_Close : BOOL;
    CMD_Valve_Test_Confirm : BOOL;
    CMD_Water_Valve_Test_Open : BOOL;
    CMD_Water_Valve_Test_Close : BOOL;
    CMD_Water_Valve_Test_Confirm : BOOL;
    CMD_Gas_Valve_Test_Open : BOOL;
    CMD_Gas_Valve_Test_Close : BOOL;
    CMD_Gas_Valve_Test_Confirm : BOOL;
    CMD_Water_Selective_Recover : BOOL;
    CMD_Gas_Selective_Recover : BOOL;
END_VAR
{attribute 'qualified_only'}
VAR_GLOBAL
    G_Any_Smoke_Input_Active : BOOL;
    G_Smoke_Active_Count : UINT;
    G_Group_Active : ARRAY[1..3] OF BOOL;
    G_Group_Pair_Confirmed : ARRAY[1..3] OF BOOL;
    G_Group_Timer_Confirmed : ARRAY[1..3] OF BOOL;
    G_Verified_By_Pair : BOOL;
    G_Verified_By_Timer : BOOL;
    G_Verified_Group : INT := 0; // 1=basement, 2=floor1, 3=floor2
    G_Verified : BOOL;
    G_Status_Text : STRING(160) := 'Smoke verification idle';
    G_Last_Update_MS : UDINT := 0;
END_VAR

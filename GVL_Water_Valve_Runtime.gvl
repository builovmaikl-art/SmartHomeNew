{attribute 'qualified_only'}
VAR_GLOBAL
    // ==============================================================================
    // Water/Flood valve governance publication.
    // ==============================================================================
    //
    // Observe-first valve governance and confirmation visibility.
    //
    // This layer publishes:
    // - valve runtime semantics;
    // - authority visibility;
    // - confirmation semantics;
    // - degraded-state visibility.
    //
    // This layer does NOT directly own physical outputs.
    // ==============================================================================

    G_Valve_Runtime_State : ARRAY[1..64] OF ST_Water_Valve_Runtime_State;

    // Aggregated visibility.
    G_Any_Valve_Degraded : BOOL;
    G_Any_Confirmation_Unknown : BOOL;
    G_Any_Unsafe_Reopen_Denied : BOOL;

    // Lifecycle.
    G_Runtime_Valid : BOOL;
    G_Last_Update_MS : UDINT;

    // Explainability.
    G_Status_Code : UINT;
    G_Status_Text : STRING(128);
END_VAR
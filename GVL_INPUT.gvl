VAR_GLOBAL
    // Normalized input read-model.
    // PRG_IO_Read still owns raw IO acquisition and calibration.
    // PRG_Input_Processing projects validated state into this layer.

    IN_Last_Update_MS : UDINT := 0;
    IN_Source_Valid : BOOL := FALSE;

    IN_Room_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    IN_Floor_Temps : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    IN_Room_Hum : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;
    IN_Room_CO2 : ARRAY[1..GVL_CONSTANTS.C_MAX_ZONES] OF REAL;

    IN_Outdoor_Temp : REAL := 0.0;
    IN_Preheat_Request : BOOL := FALSE;
    IN_Freeze_Request : BOOL := FALSE;

    IN_Water_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_FLOOD_SENSORS] OF BOOL;
    IN_Smoke_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_SMOKE_SENSORS] OF BOOL;
    IN_Methane_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_METHANE_SENSORS] OF REAL;
    IN_CO_Sensors : ARRAY[1..GVL_CONSTANTS.C_MAX_CO_SENSORS] OF REAL;

    IN_Input_Degraded : BOOL := FALSE;
    IN_Sensor_Fault : BOOL := FALSE;

    // Validation / anomaly flags.
    IN_Validation_Failed : BOOL := FALSE;
    IN_Anomaly_Detected : BOOL := FALSE;
    IN_Validation_Reason : STRING(120) := '';
    IN_Anomaly_Reason : STRING(120) := '';
    IN_Last_Invalid_Zone : INT := 0;
END_VAR
